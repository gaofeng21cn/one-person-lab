      "default": "./dist/presentation.js"
    },
    "./forms": {
      "opl-source": "./src/forms.ts",
      "types": "./dist/forms.d.ts",
      "default": "./dist/forms.js"
    },
    "./handoff": {
      "opl-source": "./src/handoff.ts",
      "types": "./dist/handoff.d.ts",
      "default": "./dist/handoff.js"

{
  "name": "@one-person-lab/package-host",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "opl-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./src/plugin.ts",
      "opl-source": "./src/plugin.ts",
      "default": "./dist/plugin.js"
    }
  },
  "files": ["dist", "contracts"],
  "scripts": {
    "prepack": "node ../../scripts/materialize-package-contracts.mjs --package=package-host",
    "prebuild": "node ../../scripts/materialize-package-contracts.mjs --package=package-host",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "node ../../scripts/materialize-package-contracts.mjs --package=package-host",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@one-person-lab/cordis-abi": "0.1.0"
  },
  "license": "Apache-2.0"
}

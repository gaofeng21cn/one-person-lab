#!/usr/bin/env bash
set -euo pipefail

SOURCE_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE_PATH" ]]; do
  SOURCE_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
  LINK_TARGET="$(readlink "$SOURCE_PATH")"
  if [[ "$LINK_TARGET" == /* ]]; then
    SOURCE_PATH="$LINK_TARGET"
  else
    SOURCE_PATH="$SOURCE_DIR/$LINK_TARGET"
  fi
done
PKG_DIR="$(cd "$(dirname "$SOURCE_PATH")/.." && pwd)"

if [[ -f "$PKG_DIR/src/cli/bin-opld.ts" ]]; then
  exec node --conditions=opl-source --experimental-strip-types "$PKG_DIR/src/cli/bin-opld.ts" "$@"
fi

exec node "$PKG_DIR/dist/cli/bin-opld.js" "$@"

#!/usr/bin/env node
import { spawn } from 'node:child_process';
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';

const BROKEN_PIPE_GUARD_KEY = Symbol.for('opl.cli.brokenPipeGuardInstalled');

function installBrokenPipeGuard(stream) {
  if (!stream || typeof stream.on !== 'function' || stream[BROKEN_PIPE_GUARD_KEY]) return;
  stream[BROKEN_PIPE_GUARD_KEY] = true;
  stream.on('error', (err) => {
    if (err?.code === 'EPIPE' || err?.code === 'ERR_STREAM_DESTROYED') return;
    throw err;
  });
}

installBrokenPipeGuard(process.stdout);
installBrokenPipeGuard(process.stderr);

const entryPath = fs.realpathSync(fileURLToPath(import.meta.url));
const rootDir = path.resolve(path.dirname(entryPath), '..');
const srcBin = path.join(rootDir, 'packages', 'daemon', 'src', 'cli', 'bin-opl.ts');
const distBin = path.join(rootDir, 'packages', 'daemon', 'dist', 'cli', 'bin-opl.js');

const useDist = process.env.OPL_USE_DIST === '1';

if (!useDist && fs.existsSync(srcBin)) {
  if (process.execArgv.includes('--conditions=opl-source')) {
    await import(pathToFileURL(srcBin).href);
  } else {
    const child = spawn(
      process.execPath,
      ['--conditions=opl-source', '--experimental-strip-types', srcBin, ...process.argv.slice(2)],
      { stdio: 'inherit' },
    );

    const forwardSignal = (signal) => {
      if (child.exitCode === null && child.signalCode === null) {
        try {
          child.kill(signal);
        } catch (error) {
          if (error?.code !== 'ESRCH') {
            throw error;
          }
        }
      }
    };

    process.on('SIGINT', forwardSignal);
    process.on('SIGTERM', forwardSignal);

    child.on('error', (error) => {
      process.off('SIGINT', forwardSignal);
      process.off('SIGTERM', forwardSignal);
      process.stderr.write(`Failed to launch OPL v2 CLI: ${error instanceof Error ? error.message : String(error)}\n`);
      process.exitCode = 1;
    });

    child.on('close', (code, signal) => {
      process.off('SIGINT', forwardSignal);
      process.off('SIGTERM', forwardSignal);
      if (signal) {
        try {
          process.kill(process.pid, signal);
        } catch {
          process.exit(1);
        }
        return;
      }
      process.exit(code ?? 1);
    });
  }
} else if (fs.existsSync(distBin)) {
  await import(pathToFileURL(distBin).href);
} else {
  process.stderr.write(
    `OPL v2 CLI entrypoint not found (checked ${srcBin} and ${distBin}). Run "npm run build" first.\n`,
  );
  process.exit(1);
}

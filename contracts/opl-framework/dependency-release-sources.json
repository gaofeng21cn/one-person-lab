{
  "schema_version": "opl.dependency-release-sources.v1",
  "owner": "opl-framework",
  "selection": "latest_stable_at_operation_start",
  "stale_fallback_allowed": false,
  "version_override_policy": "test_fixture_only",
  "sources": {
    "kimi-cu": {
      "kind": "json-manifest",
      "url": "https://cdn.kimi.com/kimi-computer-use/latest/version.json",
      "platforms": { "darwin-arm64": "app", "darwin-x64": "app_x86_64" },
      "install_metadata": { "format": "app-zip", "bundle_id": "ai.kimi.cu", "bundle_name": "KimiCU.app" }
    },
    "codex-cli": { "kind": "npm", "package": "@openai/codex", "dist_tag": "latest", "platform_optional_dependency": "@openai/codex-{platform}-{architecture}", "install_metadata": { "format": "npm", "binary": "codex" } },
    "mineru-open-api": { "kind": "npm", "package": "mineru-open-api", "repository": "opendatalab/MinerU-Ecosystem", "source_commit_required": true, "dist_tag": "latest", "install_metadata": { "format": "npm", "binary": "mineru-open-api" } },
    "playwright-mcp": { "kind": "npm", "package": "@playwright/mcp", "dist_tag": "latest", "install_metadata": { "format": "npm", "binary": "mcp-server-playwright" } },
    "temporal-cli": { "kind": "github-release", "repository": "temporalio/cli", "asset": "temporal_cli_{version}_{platform}_{go_arch}.tar.gz", "install_metadata": { "format": "tar.gz", "binary": "temporal" } },
    "officecli": { "kind": "github-release", "repository": "iOfficeAI/OfficeCLI", "source_commit_required": true, "asset": "officecli-{office_platform}-{architecture}{exe_suffix}", "install_metadata": { "format": "binary", "binary": "officecli", "executable_entry": "officecli" } },
    "bun": { "kind": "github-release", "repository": "oven-sh/bun", "version_prefix": "bun-v", "asset": "bun-{platform}-{rust_arch}.zip", "install_metadata": { "format": "zip", "binary": "bun" } },
    "uv": { "kind": "github-release", "repository": "astral-sh/uv", "asset": "uv-{rust_arch}-{rust_target}.tar.gz", "install_metadata": { "format": "tar.gz", "binary": "uv" } },
    "python": { "kind": "github-release", "repository": "astral-sh/python-build-standalone", "asset_pattern": "^cpython-(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)\\+[^-]+-{rust_arch}-{rust_target}-install_only_stripped\\.tar\\.gz$", "install_metadata": { "format": "tar.gz", "binary": "python3", "strip_components": 1 } },
    "node": { "kind": "node-index", "url": "https://nodejs.org/dist/index.json", "install_metadata": { "format": "tar.gz", "binary": "node", "strip_components": 1 } },
    "go": { "kind": "go-index", "url": "https://go.dev/dl/?mode=json", "install_metadata": { "format": "tar.gz", "binary": "go", "strip_components": 1 } },
    "zstd": { "kind": "github-release", "repository": "facebook/zstd", "asset": "zstd-{version}.tar.gz", "install_metadata": { "format": "source-tar.gz", "binary": "zstd", "build": "make" } }
  },
  "first_party_source": { "kind": "git-default", "selection": "repository_default_branch_commit", "version_path": "package.json" }
}

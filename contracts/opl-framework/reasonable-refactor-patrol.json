{
  "contract_kind": "opl_reasonable_refactor_patrol.v1",
  "surface_kind": "opl_reasonable_refactor_patrol",
  "owner": "one-person-lab",
  "state": "active_contract",
  "purpose": "Keep the scheduled OPL family refactor patrol complexity-first, SSOT-aware, authority-safe, and bounded without encoding fixed candidate quotas or a second development methodology in the Automation prompt.",
  "machine_boundary": "This contract owns the OPL-family refactor patrol scope, candidate vocabulary, authority gates, batch-state shape, and closeout invariants. It does not authorize domain truth changes, release or installation, upstream fork-body edits, or physical deletion without current owner evidence.",
  "authority_order": [
    "latest_direct_user_instruction",
    "repo_local_agents_contracts_canonical_source_runtime",
    "current_lifecycle_owner_and_real_callers",
    "advisory_scan_evidence"
  ],
  "scope": {
    "start_repo": "one-person-lab",
    "default_repositories": [
      "one-person-lab",
      "med-autoscience",
      "med-autogrant",
      "redcube-ai",
      "opl-meta-agent",
      "one-person-lab-app",
      "opl-bookforge"
    ],
    "excluded_repositories": [
      "opl-aion-shell"
    ],
    "excluded_path_prefixes": {
      "one-person-lab-app": [
        "shells/aionui/",
        "_external/hermes-agent/"
      ]
    },
    "dynamic_admission": "existing_sibling_repo_with_repo_local_owner_and_opl_owned_surface",
    "missing_or_retired_repo_policy": "not_a_backlog_item",
    "fork_body_policy": "read_only_excluded"
  },
  "routing": {
    "complexity_and_shape": "refactor_patrol",
    "docs_ssot_or_history_pollution": "governance_ssot_handoff",
    "domain_or_release_authority": "owner_lane",
    "confirmed_behavior_bug": "develop_and_deliver_owner_lane"
  },
  "evidence_sources": [
    "family_structure_advisory",
    "line_budget",
    "ponytail_audit_when_installed",
    "codegraph_callers_and_dependencies",
    "repo_native_tests_and_contracts",
    "git_worktree_lifecycle_and_remote_readback"
  ],
  "candidate": {
    "tags": [
      "delete",
      "shrink",
      "yagni",
      "stdlib",
      "native"
    ],
    "statuses": [
      "candidate",
      "selected",
      "done",
      "deleted",
      "shrunk",
      "done_gate_no_delete",
      "no_safe_change",
      "blocked_owner_gated",
      "not_safe",
      "watch_only",
      "rejected_not_complexity_debt"
    ],
    "required_authority_fields": [
      "id",
      "repo",
      "truth_owner",
      "owner_surface",
      "candidate",
      "tag",
      "route",
      "active_caller_evidence",
      "authority_blocker",
      "allowed_write_set",
      "forbidden_write_set",
      "risk_class",
      "verification_command",
      "estimated_complexity_reduction",
      "status",
      "selected_or_skipped_reason",
      "source_provenance_class",
      "source_provenance_evidence",
      "reserve_capability_assessment",
      "replacement_or_retirement_evidence"
    ]
  },
  "provenance_policy": {
    "required_before_delete": [
      "source_provenance_class",
      "source_provenance_evidence",
      "reserve_capability_assessment",
      "replacement_or_retirement_evidence"
    ],
    "classes": [
      "user_requested",
      "externally_learned",
      "contract_or_owner_required",
      "model_invented",
      "unknown"
    ],
    "default_action": {
      "user_requested": "preserve",
      "externally_learned": "preserve",
      "contract_or_owner_required": "route_to_owner",
      "model_invented": "investigate_then_delete_only_with_no_consumer_and_no_reserve_value",
      "unknown": "preserve_and_block_delete"
    },
    "protected_surface_hints": [
      "research",
      "connector",
      "provider",
      "integration",
      "external_learning",
      "reference",
      "scientific",
      "reserve"
    ],
    "no_caller_is": "investigation_signal_only",
    "known_protected_reserve_capabilities": [
      {
        "id": "opl-connect-ncbi-reference-parsers",
        "owner_surface": "src/adapters/integration/opl-connect-reference-ncbi.ts",
        "provenance_classes": ["user_requested", "externally_learned"],
        "evidence_refs": [
          "git:21d8079fe:feat(connect): provide PubMed and PMC receipts",
          "user_instruction:2026-08-17:preserve externally learned NCBI research capability"
        ],
        "retention": "preserve_as_tested_research_reserve_even_without_an_active_caller"
      }
    ]
  },
  "execution_policy": {
    "mode": "wide_probe_narrow_mutate",
    "selection": "highest_value_coherent_packages_that_fit_current_verification_and_integration_budget",
    "fixed_candidate_quota": false,
    "fixed_selected_package_quota": false,
    "fixed_line_budget_percentage": false,
    "line_budget_role": "review_trigger_and_design_signal_not_mechanical_split_authority",
    "mutation_gate": "ssot_aligned_current_owner_known_safe_semantic_boundary_and_repo_native_verification",
    "single_package_policy": "allowed_when_it_is_the_highest_value_coherent_executable_batch",
    "parallelism": "only_when_independent_worktrees_have_distinct_execution_owners_and_verification_fan_in",
    "shared_mutation": "short_single_operation_owner",
    "unselected_backlog": "next_scheduled_run_or_explicit_user_instruction"
  },
  "modularity_policy": {
    "principle": "Keep each source file centered on a cohesive responsibility and split oversized multi-responsibility files along natural semantic boundaries.",
    "admission_evidence": [
      "explicit_user_requested_organization",
      "distinct_responsibilities_with_clear_dependency_direction",
      "closed_function_or_policy_families_with_known_consumers",
      "navigation_or_conflict_surface_reduction",
      "reproducible_duplicate_or_maintenance_failure_when_present"
    ],
    "prior_incident_required": false,
    "owner_presence": "The current owner is the implementation lane, not a reason to retain an oversized file.",
    "dependency_repair": "When an extraction would introduce a cycle, first consider an existing lower-level primitive or a small shared type/value leaf within the same owner; do not stop solely because the first extraction sketch is cyclic.",
    "preservation": "Preserve behavior, public facades/exports, identity, errors, ordering, bytes, capability and authority. Protected provenance permits behavior-preserving organization but never authorizes capability retirement.",
    "acceptance": [
      "review each original and destination file by responsibility and size",
      "keep dependency direction explicit and avoid reverse facade imports",
      "do not relocate a monolith into another oversized helper or constants bucket",
      "do not use numbered parts or line slices without semantic boundaries",
      "explain any remaining long cohesive file with source-specific reasons"
    ],
    "line_count_is_not": "a universal hard maximum or a substitute for semantic judgment"
  },
  "reporting_policy": {
    "file_metrics": "Record path, before_lines, after_lines and responsibility for every changed or newly introduced source/test file.",
    "aggregation": "Report per-file rows first; label aggregate numbers explicitly as multi-file totals and include the file count.",
    "separate_measures": [
      "largest_original_and_destination_file",
      "source_and_test_line_deltas",
      "new_files_and_dependency_tradeoff",
      "maintained_or_removed_capabilities"
    ],
    "state_field": "work_packages[].file_metrics"
  },
  "reuse_first": {
    "order": [
      "existing_project_primitive",
      "standard_library",
      "native_platform",
      "installed_dependency",
      "stable_external_dependency_after_owner_review"
    ],
    "new_dependency": "owner_review_required",
    "keep_custom": "record_reason_scope_and_retirement_trigger"
  },
  "state_contract": {
    "schema": "contracts/opl-framework/reasonable-refactor-patrol-state.schema.json",
    "validator": "node scripts/refactor-patrol-state.mjs validate --input <state.json>",
    "selected_batch_invariant": "every_selected_package_has_exactly_one_burn_down_entry",
    "terminal_invariant": "every_selected_package_is_terminal_verified_absorbed_or_explicitly_gated",
    "memory_policy": "compact_current_state_plus_append_only_history"
  },
  "forbidden_patterns": [
    "codex_ops_kit_default_methodology",
    "fixed_subagent_choreography",
    "quota_driven_candidate_invention",
    "threshold_only_file_splitting",
    "fork_body_refactor",
    "docs_or_tests_as_runtime_or_release_truth",
    "lane_success_as_run_closeout",
    "delete_from_no_caller_without_provenance",
    "delete_user_requested_or_externally_learned_reserve",
    "treat_unknown_provenance_as_model_invented",
    "require_incident_before_owner_held_organization",
    "move_monolith_into_new_helper_bucket",
    "numbered_part_or_length_only_split",
    "report_package_total_as_single_file"
  ],
  "terminal_states": [
    "completed",
    "no_safe_batch",
    "checkpointed",
    "blocked"
  ]
}

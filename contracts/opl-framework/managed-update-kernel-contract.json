{
  "schema_version": 1,
  "owner": "one-person-lab",
  "purpose": "managed_update_kernel_contract",
  "state": "active",
  "background_maintenance": {
    "plan_eligibility_before_apply": true,
    "installed_packages_only": true,
    "local_user_sources": "manual_required",
    "native_freshness_without_probe": "currentness_not_checked",
    "native_update": "idempotent_owner_refresh_then_fresh_callable_readback",
    "base_apply": "stage_verified_generation_without_activation_or_temporal_restart",
    "failure_isolation": "continue_unrelated_installed_packages"
  },
  "surface_id": "opl_managed_updater_kernel",
  "runtime_activation": {
    "command": "opl update activate --json",
    "output": "runtime_activation.status, runtime_activation.codex, runtime_activation.framework",
    "codex_runtime_binary_path": "runtime_activation.codex.runtime_binary_path is the existing managed executable path or null; App preserves explicit user binary selection",
    "scope": "verified_pending_generations_only",
    "lock": "opl_managed_updater_kernel.global",
    "lock_operation": "apply",
    "same_app_instance": "deferred_same_app_instance",
    "network_allowed": false,
    "download_allowed": false,
    "package_update_allowed": false,
    "temporal_start_or_restart_allowed": false,
    "developer_source_overwrite_allowed": false,
    "codex_verification": "version_and_sha256_bound_initialize_initialized_thread_list_smoke_in_isolated_codex_home",
    "framework_verification": "staged_generation_content_sha256",
    "legacy_unverified_pending": "manual_required_restage_with_update_apply",
    "rollback_command": "opl update rollback --json"
  },
  "public_cli_surfaces": [
    "opl update status --json",
    "opl app state --profile fast --json",
    "opl update check --json",
    "opl update plan --json",
    "opl update apply --json",
    "opl update activate --json",
    "opl update repair --receipt <receipt_id> --json",
    "opl update rollback --json",
    "opl packages list --json",
    "opl packages install <package_id> --json",
    "opl packages update --json",
    "opl packages enable --package-id <id> --json",
    "opl packages disable --package-id <id> --json",
    "opl packages repair --package-id <id> --json",
    "opl packages uninstall --package-id <id> --json"
  ],
  "kernel_lifecycle": [
    "read_manifest",
    "read_current_state",
    "diff_plan",
    "fetch_artifacts",
    "verify",
    "stage",
    "activate",
    "post_apply",
    "write_receipt",
    "report_status_or_repair"
  ],
  "component_state_vocabulary": [
    "current",
    "currentness_not_checked",
    "update_available",
    "staged",
    "needs_restart",
    "needs_reload",
    "failed_with_repair",
    "skipped_manual_required"
  ],
  "base_dependency_catalog_contract": {
    "surface_kind": "opl_base_managed_dependency_catalog.v1",
    "required_dependency_fields": [
      "dependency_id",
      "dependency_kind",
      "installed",
      "version",
      "latest_version",
      "currentness",
      "ownership",
      "update_mode",
      "update_action"
    ],
    "currentness_values": [

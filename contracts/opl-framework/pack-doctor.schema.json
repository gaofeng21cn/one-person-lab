{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-person-lab.local/contracts/opl-framework/pack-doctor.schema.json",
  "title": "OPL Declarative Pack Dependency Doctor Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surface_kind",
    "schema_version",
    "pack_id",
    "owner"
  ],
  "properties": {
    "surface_kind": {
      "const": "opl_pack_doctor_spec"
    },
    "schema_version": {
      "const": 1
    },
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "provisioning_owner": {
      "type": "string",
      "minLength": 1
    },
    "automatic_install_allowed": {
      "const": false
    },
    "extra_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cli_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "version_args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "install_hint": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "python_module_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module"],
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1
          },
          "package_name": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "install_hint": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "node_package_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "install_hint": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

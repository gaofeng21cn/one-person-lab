{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-person-lab.local/contracts/opl-framework/agent-package-manifest.schema.json",
  "title": "OPL Agent Package Manifest",
  "type": "object",
  "required": [
    "surface_kind",
    "agent_id",
    "package_id",
    "version",
    "source",
    "source_repo",
    "display_name",
    "publication_projection_order",
    "publication_source",
    "runtime_source_carrier",
    "standard_agent_descriptor_projection",
    "carrier_source_role",
    "codex_surface",
    "capability_dependencies"
  ],
  "properties": {
    "surface_kind": {
      "const": "opl_agent_package_manifest.v1"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "owner_language_version": {
      "type": "object",
      "required": ["scheme", "value"],
      "properties": {
        "scheme": { "const": "pep440" },
        "value": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "source_repo": {
      "type": "string",
      "format": "uri-reference",
      "minLength": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "publication_projection_order": {
      "type": "integer",
      "minimum": 0
    },
    "publication_source": {
      "type": "object",
      "required": [
        "owner_package_manifest_ref",
        "owner_plugin_manifest_ref"
      ],
      "properties": {
        "module_id": { "type": "string", "minLength": 1 },
        "owner_package_manifest_ref": { "type": "string", "minLength": 1 },
        "owner_plugin_manifest_ref": { "type": "string", "minLength": 1 },
        "owner_language_version_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "standard_agent_descriptor_projection": {
      "type": "object",
      "required": [
        "surface_kind",
        "source_ref",
        "interface_source_ref",
        "domain_id",
        "runtime_domain_id",
        "explicit_aliases",
        "compatibility"
      ],
      "properties": {
        "surface_kind": { "const": "opl_standard_agent_descriptor_projection.v1" },
        "source_ref": { "type": "string", "minLength": 1 },
        "interface_source_ref": { "type": "string", "minLength": 1 },
        "domain_id": { "type": "string", "minLength": 1 },
        "runtime_domain_id": { "type": "string", "minLength": 1 },
        "short_label": { "type": "string", "minLength": 1 },
        "explicit_aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "compatibility": {
          "type": "object",
          "required": ["registry_domain_id", "owner_aliases"],
          "properties": {
            "registry_domain_id": { "type": "string", "minLength": 1 },
            "aliases": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "owner_aliases": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "presentation": {
      "type": "object",
      "required": [
        "display_name_i18n",
        "description_i18n",
        "session_routing_summary_i18n",
        "home_shortcuts"
      ],
      "properties": {
        "display_name_i18n": { "$ref": "#/$defs/localized_text" },
        "description_i18n": { "$ref": "#/$defs/localized_text" },
        "session_routing_summary_i18n": { "$ref": "#/$defs/localized_text" },
        "home_shortcuts": {
          "type": "array",
          "items": { "$ref": "#/$defs/home_shortcut" }
        }
      },
      "additionalProperties": false
    },
    "app_contributions": {
      "$ref": "#/$defs/app_contributions"
    },
    "registry_entry": {
      "type": "object",
      "required": [
        "registry_kind",
        "registry_source_ref",
        "base_contract_role",
        "base_contract_invariant",
        "identity_fields"
      ],
      "properties": {
        "registry_kind": {
          "type": "string",
          "minLength": 1
        },
        "registry_source_ref": {
          "type": "string",
          "minLength": 1
        },
        "base_contract_role": {
          "const": "registry_data_not_base_invariant"
        },
        "base_contract_invariant": {
          "const": false
        },
        "identity_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "admitted_domain_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "carrier_source_role": {
      "const": "codex_plugin_default_carrier_not_package_truth"
    },
    "package_core": {
      "type": "object",
      "required": [
        "core_kind",
        "identity_fields",
        "content_identity_fields",
        "dependency_source",
        "exposure_owner"
      ],
      "properties": {
        "core_kind": {
          "const": "opl_agent_package_core"
        },
        "identity_fields": {
          "type": "array",
          "items": {
            "enum": [
              "package_id",
              "agent_id",
              "version"
            ]
          },
          "minItems": 3,
          "uniqueItems": true
        },
        "content_identity_fields": {
          "type": "array",
          "items": {
            "enum": [
              "manifest_sha256",
              "payload_digest_ref",
              "required_skill_pack_lock_refs"
            ]
          },
          "minItems": 3,
          "uniqueItems": true
        },
        "dependency_source": {
          "const": "manifest_declared_capability_dependencies"
        },
        "exposure_owner": {
          "const": "opl_connect_agent_package_registry"
        }
      },
      "additionalProperties": true
    },
    "distribution_payload": {
      "description": "Optional published distribution metadata. Source-only or unpublished packages omit this property.",
      "type": "object",
      "required": [
        "payload_kind",
        "payload_ref",
        "payload_digest_ref",
        "required_skill_pack_lock_refs",
        "proof_status",
        "live_download_proof",
        "installed_reload_proof",
        "oci_ref",
        "oci_media_type",
        "immutable_tag",
        "moving_tag",
        "promotion_policy",
        "install_truth"
      ],
      "properties": {
        "payload_kind": {
          "type": "string",
          "minLength": 1
        },
        "payload_ref": {
          "type": "string",
          "minLength": 1
        },
        "payload_digest_ref": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "required_skill_pack_lock_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "proof_status": {
          "type": "string",
          "minLength": 1
        },
        "live_download_proof": {
          "const": false
        },
        "installed_reload_proof": {
          "const": false
        },
        "oci_ref": {
          "type": "string",
          "minLength": 1
        },
        "oci_media_type": {
          "type": "string",
          "minLength": 1
        },
        "immutable_tag": {
          "type": "string",
          "minLength": 1
        },
        "moving_tag": {
          "const": "latest-stable"
        },
        "promotion_policy": {
          "const": "daily_candidate_gates_then_promote_latest_stable"
        },
        "install_truth": {
          "const": "resolved_digest_lock"
        }
      },
      "additionalProperties": true
    },
    "codex_surface": {
      "type": "object",
      "required": [
        "plugin_id",
        "standalone_distribution",
        "required_skill_ids"
      ],
      "properties": {
        "plugin_id": {
          "type": "string",
          "minLength": 1
        },
        "plugin_payload_manifest_url": {
          "type": "string",
          "minLength": 1
        },
        "carrier_source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "standalone_distribution": {
          "enum": [
            "repo_carrier_source",
            "generated_carrier_surface"
          ]
        },
        "required_skill_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "profile_surface": {
      "type": "object",
      "required": [
        "runtime_profile",
        "authoring_sources",
        "merge_context_paths",
        "existing_profile_policy"
      ],
      "properties": {
        "runtime_profile": {
          "type": "object",
          "required": ["source_path", "target_id"],
          "properties": {
            "source_path": { "type": "string", "minLength": 1 },
            "target_id": { "const": "user_agents_profile" }
          },
          "additionalProperties": false
        },
        "authoring_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_path", "target_id"],
            "properties": {
              "source_path": { "type": "string", "minLength": 1 },
              "target_id": { "const": "user_taste_source" }
            },
            "additionalProperties": false
          }
        },
        "merge_context_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "existing_profile_policy": {
          "const": "semantic_merge_required"
        }
      },
      "additionalProperties": false
    },
    "managed_policy_surface": {
      "type": "object",
      "required": [
        "policy_kind",
        "source_path",
        "schema_path"
      ],
      "properties": {
        "policy_kind": {
          "const": "opl_flow_workflow_policy"
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "schema_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "runtime_source_carrier": {
      "type": "object",
      "required": [
        "carrier_kind",
        "module_id"
      ],
      "properties": {
        "carrier_kind": {
          "const": "opl_managed_module_source"
        },
        "module_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "managed_update_source": {
      "type": "object",
      "required": ["kind", "transport", "catalog_ref", "digest_authority"],
      "properties": {
        "kind": { "const": "managed_version_catalog" },
        "transport": { "enum": ["json_url", "opl_oci_channel"] },
        "catalog_ref": { "type": "string", "minLength": 1 },
        "digest_authority": { "const": "manifest_and_content_digest" }
      },
      "additionalProperties": false
    },
    "carrier_adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "adapter_kind",
          "carrier",
          "source_surface",
          "projection_role",
          "owns_domain_truth"
        ],
        "properties": {
          "adapter_kind": {
            "const": "codex_plugin_carrier"
          },
          "carrier": {
            "const": "codex_plugin"
          },
          "source_surface": {
            "const": "codex_surface"
          },
          "projection_role": {
            "const": "package_carrier_adapter"
          },
          "owns_package_core": {
            "const": false
          },
          "owns_domain_truth": {
            "const": false
          }
        },
        "additionalProperties": true
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "dependency_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "profile_id",
          "profile_kind",
          "profile_owner",
          "domain_id",
          "domain_truth_owner",
          "source",
          "opl_role",
          "source_profile_sha256",
          "authority_boundary"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "minLength": 1
          },
          "profile_kind": {
            "const": "domain_dependency_profile"
          },
          "profile_owner": {
            "type": "string",
            "minLength": 1
          },
          "domain_id": {
            "type": "string",
            "minLength": 1
          },
          "domain_truth_owner": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "required": [
              "source_kind",
              "profile_ref",
              "helper_ref"
            ],
            "properties": {
              "source_kind": {
                "const": "domain_profile_ref"
              },
              "profile_ref": {
                "type": "string",
                "minLength": 1
              },
              "helper_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          },
          "opl_role": {
            "const": "dependency_environment_check"
          },
          "source_descriptor_ref": {
            "type": "string",
            "minLength": 1
          },
          "source_profile_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "dependency_id",
                "kind",
                "required_level",
                "purpose"
              ],
              "properties": {
                "dependency_id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "executable",
                    "latex_package"
                  ]
                },
                "required_level": {
                  "enum": [
                    "required",
                    "optional",
                    "legacy_not_required"
                  ]
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                },
                "install_target": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "authority_boundary": {
            "type": "object",
            "required": [
              "can_write_domain_truth",
              "can_write_artifact_body",
              "can_authorize_domain_readiness",
              "can_authorize_artifact_or_export_readiness",
              "can_issue_owner_receipt"
            ],
            "properties": {
              "can_write_domain_truth": {
                "const": false
              },
              "can_write_artifact_body": {
                "const": false
              },
              "can_authorize_domain_readiness": {
                "const": false
              },
              "can_authorize_artifact_or_export_readiness": {
                "const": false
              },
              "can_issue_owner_receipt": {
                "const": false
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "uniqueItems": true
    },
    "capability_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "package_id",
          "required",
          "capability_abi",
          "required_export_ids",
          "required_module_ids",
          "authority_boundary"
        ],
        "properties": {
          "module_id": {
            "type": "string",
            "minLength": 1
          },
          "package_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "capability_package",
              "framework_capability_package"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "dependency_kind": {
            "enum": [
              "hard_runtime_dependency",
              "optional_enhancement"
            ]
          },
          "version_requirement": {
            "type": "string",
            "minLength": 1
          },
          "capability_abi": {
            "type": "string",
            "minLength": 1
          },
          "consumer_profile_id": {
            "type": "string",
            "minLength": 1
          },
          "required_export_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "required_module_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "bootstrap_manifest_url": {
            "type": "string",
            "minLength": 1
          },
          "dependency_source": {
            "type": "object",
            "required": ["kind", "transport", "catalog_ref", "digest_authority"],
            "properties": {
              "kind": { "const": "managed_version_catalog" },
              "transport": { "enum": ["json_url", "opl_oci_channel"] },
              "catalog_ref": { "type": "string", "minLength": 1 },
              "digest_authority": { "const": "manifest_and_content_digest" }
            },
            "additionalProperties": true
          },
          "codex_distribution": {
            "const": "bundled"
          },
          "opl_distribution": {
            "const": "managed_dependency"
          },
          "developer_distribution": {
            "const": "source_checkout"
          },
          "required_for": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "install_owner": {
            "const": "one-person-lab"
          },
          "install_update_source": {
            "const": "ghcr_capability_packages_channel"
          },
          "sync_scopes": {
            "type": "array",
            "items": {
              "enum": [
                "workspace",
                "quest"
              ]
            },
            "minItems": 2,
            "uniqueItems": true
          },
          "authority_boundary": {
            "type": "object",
            "required": [
              "can_write_domain_truth",
              "can_sign_owner_receipt",
              "can_create_typed_blocker",
              "can_write_runtime_queue"
            ],
            "properties": {
              "can_write_domain_truth": {
                "const": false
              },
              "can_sign_owner_receipt": {
                "const": false
              },
              "can_create_typed_blocker": {
                "const": false
              },
              "can_write_runtime_queue": {
                "const": false
              }
            },
            "additionalProperties": true
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "required": {
                  "const": true
                }
              },
              "required": [
                "required"
              ]
            },
            "then": {
              "properties": {
                "dependency_kind": {
                  "const": "hard_runtime_dependency"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "required": {
                  "const": false
                }
              },
              "required": [
                "required"
              ]
            },
            "then": {
              "required": [
                "dependency_kind"
              ],
              "properties": {
                "dependency_kind": {
                  "const": "optional_enhancement"
                }
              }
            }
          }
        ],
        "additionalProperties": true
      }
    },
    "capability_provider": {
      "type": "object",
      "required": [
        "capability_abi",
        "exports",
        "module_export_ids"
      ],
      "properties": {
        "capability_abi": {
          "type": "string",
          "minLength": 1
        },
        "exports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "export_id",
              "skill_id",
              "install_mode"
            ],
            "properties": {
              "export_id": {
                "type": "string",
                "minLength": 1
              },
              "skill_id": {
                "type": "string",
                "minLength": 1
              },
              "install_mode": {
                "enum": [
                  "core_required",
                  "optional_named_specialty"
                ]
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        },
        "module_export_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "consumer_profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "profile_id",
              "consumer_agent_id",
              "required_export_ids",
              "required_module_ids"
            ],
            "properties": {
              "profile_id": { "type": "string", "minLength": 1 },
              "consumer_agent_id": { "type": "string", "minLength": 1 },
              "required_export_ids": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "minItems": 1,
                "uniqueItems": true
              },
              "required_module_ids": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "localized_text": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "home_shortcut": {
      "type": "object",
      "required": [
        "shortcut_id",
        "label_i18n",
        "default_visible",
        "user_configurable",
        "route"
      ],
      "properties": {
        "shortcut_id": { "type": "string", "minLength": 1 },
        "label_i18n": { "$ref": "#/$defs/localized_text" },
        "default_visible": { "type": "boolean" },
        "user_configurable": { "type": "boolean" },
        "route": {
          "type": "object",
          "required": ["route_kind", "executor", "codex_visible_entry"],
          "properties": {
            "route_kind": { "const": "agent_package_shortcut" },
            "executor": { "const": "codex_cli" },
            "codex_visible_entry": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "app_contributions": {
      "type": "object",
      "required": ["schema_version"],
      "anyOf": [
        {
          "required": ["navigation"],
          "properties": { "navigation": { "minItems": 1 } }
        },
        {
          "required": ["views"],
          "properties": { "views": { "minItems": 1 } }
        },
        {
          "required": ["commands"],
          "properties": { "commands": { "minItems": 1 } }
        },
        {
          "required": ["badges"],
          "properties": { "badges": { "minItems": 1 } }
        }
      ],
      "properties": {
        "schema_version": { "const": "opl-app-contributions.v1" },
        "navigation": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["navigation_id", "label_i18n", "view_id"],
            "properties": {
              "navigation_id": { "$ref": "#/$defs/app_contribution_id" },
              "label_i18n": { "$ref": "#/$defs/app_contribution_localized_text" },
              "view_id": { "$ref": "#/$defs/app_contribution_id" },
              "icon_id": { "$ref": "#/$defs/app_contribution_id" },
              "sort_order": { "type": "integer", "minimum": -10000, "maximum": 10000 }
            },
            "additionalProperties": false
          }
        },
        "views": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["view_id", "view_type", "title_i18n", "data_ref"],
            "properties": {
              "view_id": { "$ref": "#/$defs/app_contribution_id" },
              "view_type": {
                "enum": [
                  "list_detail",
                  "timeline",
                  "approval_diff",
                  "task_board",
                  "artifact_view",
                  "activity_log"
                ]
              },
              "title_i18n": { "$ref": "#/$defs/app_contribution_localized_text" },
              "data_ref": { "$ref": "#/$defs/app_contribution_ref" },
              "command_ids": {
                "type": "array",
                "maxItems": 100,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/app_contribution_id" }
              },
              "badge_ids": {
                "type": "array",
                "maxItems": 100,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/app_contribution_id" }
              },
              "empty_state_i18n": {
                "$ref": "#/$defs/app_contribution_localized_text"
              }
            },
            "additionalProperties": false
          }
        },
        "commands": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["command_id", "label_i18n", "action_ref"],
            "properties": {
              "command_id": { "$ref": "#/$defs/app_contribution_id" },
              "label_i18n": { "$ref": "#/$defs/app_contribution_localized_text" },
              "action_ref": { "$ref": "#/$defs/app_contribution_ref" },
              "confirmation_required": { "type": "boolean" }

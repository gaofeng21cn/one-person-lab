{
  "version": "cordis-architecture-profile.v1",
  "scope": "opl_framework_cordis_architecture_profile",
  "owner": "OPL Framework",
  "state": "landed/default",
  "machine_boundary": "This contract freezes the Cordis-native target shape and migration gates. It is not an installed Package registry, currentness record, lock, resolver, durable event log, domain verdict, Foundry activation record, or App product truth.",
  "source_refs": [
    "contracts/opl-framework/cordis-surface-map.json",
    "contracts/opl-framework/cordis-plugin-descriptor.schema.json",
    "contracts/opl-framework/cordis-composition-snapshot.schema.json",
    "contracts/opl-framework/package-host-integration.schema.json",
    "contracts/opl-framework/package-host-context.schema.json",
    "contracts/opl-framework/standard-agent-host-contract.json",
    "contracts/opl-framework/capability-package-host-contract.json",
    "contracts/opl-framework/workflow-profile-host-contract.json",
    "contracts/opl-framework/target-operating-architecture-contract.json",
    "contracts/opl-framework/agent-package-manifest.schema.json",
    "contracts/opl-framework/source-module-map.json"
  ],
  "host_scope_boundary": {
    "framework_host": "one-person-lab-framework",
    "framework_host_scope": "framework_runtime_package_graph_and_app_projection",
    "framework_host_unique_within_scope": true,
    "studio_application_host": "opl-studio",
    "studio_application_host_scope": "dsh_profile_plugin_lifecycle_codex_and_delivery_transport_composition",
    "studio_application_host_may_exist_without_authority_transfer": true,
    "separate_hosts_do_not_create": [
      "second_opl_runtime",
      "second_package_registry",
      "second_package_currentness_authority",
      "second_app_state_or_action_authority",
      "second_domain_product_or_release_authority"
    ]
  },
  "architecture_layers": [
    {
      "layer_id": "authority_domain",
      "sequence": 1,
      "owner_question": "Which owner is accountable for facts, policy, state, product outcomes, or irreversible decisions?",
      "authority": "Domain and platform owner contracts remain canonical.",
      "cordis_role": "Cordis may consume typed refs and expose in-process policy or read services; it cannot become the authority."
    },
    {
      "layer_id": "package",
      "sequence": 2,
      "owner_question": "Which independently installable and releasable unit carries the capability?",
      "authority": "Package owner and native carrier own identity, installation, publication, currentness, and rollback artifact.",
      "cordis_role": "A Package may contribute descriptors and plugins, but a plugin is not an installed Package or a resolver."
    },
    {
      "layer_id": "cordis_plugin_contribution",
      "sequence": 3,
      "owner_question": "Which in-process capability needs independent injection, replacement, observation, scope, or teardown?",
      "authority": "The contributing module or Package owns the plugin implementation and API contract.",
      "cordis_role": "@deepseek-ai/cordis owns context, injection, typed events, effects, fibers, and lifecycle within the selected composition."
    },
    {
      "layer_id": "curated_composition_profile",
      "sequence": 4,
      "owner_question": "Which allowlisted contributions are valid for this host, scope, trust lane, and real caller?",
      "authority": "OPL Pack and the relevant host owner select a frozen composition input.",
      "cordis_role": "Cordis hydrates only the explicit allowlist; it does not expose arbitrary combinations or mutate Package currentness."
    }
  ],
  "authority_boundary": {
    "cordis_is_security_sandbox": false,
    "forbidden_authorities": [
      "package_installed_truth",
      "package_currentness",
      "native_carrier_lifecycle",
      "temporal_workflow_history",
      "temporal_retry_replay",
      "workspace_file_bytes",

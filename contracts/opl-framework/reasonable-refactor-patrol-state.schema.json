{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-person-lab.dev/schemas/reasonable-refactor-patrol-state.v1.json",
  "title": "OPL reasonable refactor patrol run state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "snapshot",
    "issue_library",
    "work_packages",
    "selected_package_ids",
    "burn_down",
    "run_status",
    "remaining"
  ],
  "properties": {
    "schema": { "const": "opl_reasonable_refactor_patrol_state.v1" },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captured_at", "source_refs"],
      "properties": {
        "captured_at": { "type": "string", "minLength": 1 },
        "source_refs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "issue_library": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "work_packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/workPackage" }
    },
    "selected_package_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "burn_down": {
      "type": "array",
      "items": { "$ref": "#/$defs/burnDown" }
    },
    "run_status": {
      "enum": ["active", "completed", "no_safe_batch", "checkpointed", "blocked"]
    },
    "no_safe_batch_reason": { "type": "string", "minLength": 1 },
    "remaining": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "repo",
        "truth_owner",
        "owner_surface",
        "candidate",
        "tag",
        "route",
        "active_caller_evidence",
        "authority_blocker",
        "allowed_write_set",
        "forbidden_write_set",
        "risk_class",
        "verification_command",
        "estimated_complexity_reduction",
        "status",
        "selected_or_skipped_reason",
        "source_provenance_class",
        "source_provenance_evidence",
        "reserve_capability_assessment",
        "replacement_or_retirement_evidence"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "repo": { "type": "string", "minLength": 1 },
        "truth_owner": { "type": "string", "minLength": 1 },
        "owner_surface": { "type": "string", "minLength": 1 },
        "candidate": { "type": "string", "minLength": 1 },
        "tag": { "enum": ["delete", "shrink", "yagni", "stdlib", "native"] },
        "change_kind": { "enum": ["behavior_preserving_organization", "capability_retirement"] },
        "route": { "enum": ["refactor_patrol", "governance_ssot_handoff", "owner_lane", "develop_and_deliver_owner_lane"] },
        "active_caller_evidence": { "type": "string" },
        "authority_blocker": { "type": ["string", "null"] },
        "allowed_write_set": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "forbidden_write_set": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "risk_class": { "type": "string", "minLength": 1 },
        "verification_command": { "type": "string", "minLength": 1 },
        "estimated_complexity_reduction": { "type": "string", "minLength": 1 },
        "status": { "enum": ["candidate", "selected", "done", "deleted", "shrunk", "done_gate_no_delete", "no_safe_change", "blocked_owner_gated", "not_safe", "watch_only", "rejected_not_complexity_debt"] },
        "selected_or_skipped_reason": { "type": "string", "minLength": 1 },
        "source_provenance_class": { "enum": ["user_requested", "externally_learned", "contract_or_owner_required", "model_invented", "unknown"] },
        "source_provenance_evidence": { "type": "string", "minLength": 1 },
        "reserve_capability_assessment": { "type": "string", "minLength": 1 },
        "replacement_or_retirement_evidence": { "type": "string", "minLength": 1 }
      }
    },
    "workPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "child_candidate_ids", "repo", "semantic_boundary", "expected_complexity_reduction", "verification_fan_in", "allowed_write_set", "forbidden_write_set", "package_acceptance_gate"],
      "properties": {
        "package_id": { "type": "string", "minLength": 1 },
        "child_candidate_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "repo": { "type": "string", "minLength": 1 },
        "semantic_boundary": { "type": "string", "minLength": 1 },
        "expected_complexity_reduction": { "type": "string", "minLength": 1 },
        "verification_fan_in": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "allowed_write_set": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "forbidden_write_set": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "package_acceptance_gate": { "type": "string", "minLength": 1 },
        "file_metrics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fileMetric" } }
      }
    },
    "fileMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "before_lines", "after_lines", "responsibility"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "before_lines": { "type": "integer", "minimum": 0 },
        "after_lines": { "type": "integer", "minimum": 0 },
        "responsibility": { "type": "string", "minLength": 1 }
      }
    },
    "burnDown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "status", "evidence", "commit_or_reason", "next_action"],
      "properties": {
        "package_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["selected", "in_progress", "done", "deleted", "shrunk", "done_gate_no_delete", "no_safe_change", "blocked_owner_gated", "not_safe"] },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "commit_or_reason": { "type": ["string", "null"] },
        "next_action": { "type": "string", "minLength": 1 }
      }
    }
  }
}

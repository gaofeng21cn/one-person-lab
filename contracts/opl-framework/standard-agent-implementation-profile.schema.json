{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-person-lab.local/contracts/opl-framework/standard-agent-implementation-profile.schema.json",
  "title": "OPL Standard Domain Agent Implementation Profile Declaration",
  "$defs": {
    "declaration": {
      "type": "object",
      "required": [
        "base_profile_ref",
        "helpers"
      ],
      "properties": {
        "base_profile_ref": {
          "const": "contracts/opl-framework/standard-agent-implementation-profile.schema.json"
        },
        "helpers": {
          "type": "object",
          "required": [
            "entries"
          ],
          "properties": {
            "entries": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/helper"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "helper": {
      "type": "object",
      "required": [
        "language",
        "role",
        "source_roots"
      ],
      "properties": {
        "language": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "not": {
            "const": "rust"
          }
        },
        "role": {
          "enum": [
            "authority_function",
            "domain_helper",
            "native_helper"
          ]
        },
        "source_roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+/$"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/declaration"
}

      "framework_validation_scope": "workspace_qualification_boundary_and_generic_cas_subset",
      "result_pointer": "/standard_agent_action_run/result",
      "allowed_statuses": ["authorized", "typed_blocker", "invalid_host_input"],
      "work_item_id_pointer_source": "owner_contract_host_validation_profile",
      "provisioning_receipt_pointer": "/standard_agent_action_run/result/provisioning_receipt",
      "provisioning_receipt_path_pointer": "/standard_agent_action_run/result/provisioning_receipt/receipt_relative_path",
      "provisioning_receipt_content_binding_pointer": "/standard_agent_action_run/result/provisioning_receipt_content_binding"
    },
    "host_materialization": {
      "capability_id": "opl_domain_artifact_cas_materialization.v1",
      "request_output_field": "opl_host_materialization_request",
      "authorization_output_field_source": "bound_owner_action_host_materialization_contract",
      "receipt_output_field": "provisioning_receipt",
      "receipt_content_binding_output_field": "provisioning_receipt_content_binding",
      "operation_count": 3,
      "target_kinds": ["workspace_index", "lifecycle", "provisioning_receipt"],
      "authorization_satisfied_gate_ids": [],
      "framework_receipt_pointer": "/standard_agent_action_run/host_materialization",
      "framework_receipt_path_pointer": "/standard_agent_action_run/host_materialization/receipt_path",
      "journaled_all_or_rollback": true,
      "exact_request_replay_is_idempotent": true,
      "completed_replay_uses_existing_cas_receipt_without_owner_checkout": true,
      "completed_replay_missing_receipt_cannot_materialize": true,
      "same_domain_and_request_id_different_bytes_fails_closed": true,
      "failure_receipt_status": "failed_rolled_back"
    },
    "qualification_boundary": {
      "qualification_only": true,
      "stage_body_authorized": false,
      "business_action_authorized": false,
      "publication_authorized": false,
      "submission_authorized": false,
      "ordinary_stage_admission_reuse_allowed": false,
      "shell_requires_domain_and_framework_receipts_before_provider_start": true

{
  "contract_kind": "opl_standard_agent_hosted_action_runtime_contract.v1",
  "surface_kind": "opl_standard_agent_hosted_action_runtime_contract",
  "owner": "one-person-lab",
  "purpose": "Host Standard OPL Agent actions from an installed owner descriptor and its configured native carrier root, or an active Foundry AgentVersion, without restoring Framework-owned Package lifecycle state or moving domain authority into OPL.",
  "state": "active_contract",
  "brand_module_ownership": {
    "primary_module": "runway",
    "collaborating_modules": [
      "connect",
      "atlas",
      "pack",
      "workspace",
      "ledger"
    ]
  },
  "entry_surface": {
    "command": "opl agents run --domain <agent> --action <action_id> --workspace <absolute_path>",
    "registered_standard_agent_required": true,
    "absolute_existing_workspace_required": true,
    "unmanaged_repo_checkout_allowed": false,
    "installed_native_carrier_required_without_active_foundry_version": true
  },
  "native_package_gate": {
    "owner_module": "connect",
    "package_status_surface": "opl packages status --package-id <agent_id> --json",
    "ordinary_user_distribution": {
      "moving_pointer": "latest-stable",
      "owner_channel": "per_package_owner_oci",
      "install_truth": "installed_owner_descriptor_and_configured_native_carrier_fresh_readback"
    },
    "developer_mode_source_carrier_allowed": true,
    "developer_mode_source_carrier_requires_explicit_local_source": true,
    "developer_mode_source_carrier_must_enter_same_native_readback": true,
    "launch_requirements": {
      "package_status_launch_allowed": true,
      "installed_owner_descriptor_required": true,
      "configured_native_carrier_status": "installed",
      "configured_native_carrier_precedence": "exact_single_source",
      "configured_native_carrier_enabled": true,
      "configured_native_carrier_executor_status": "callable",
      "plugin_source_path_absolute_repo_root": true,
      "owner_manifest_package_version_plugin_selector_and_marketplace_match_readback": true,
      "source_tree_sha256_required": true,
      "action_contracts_resolve_from_carrier_root": true
    },
    "runtime_provenance_source_kind": "installed_native_carrier",
    "package_use_binding_required": false,
    "package_lock_ref_allowed": false,
    "scope_activation_required": false,
    "legacy_managed_checkout_fallback_allowed": false,
    "moving_pointer_is_install_truth": false,
    "origin_main_is_implicit_launch_target": false,
    "failure_policy": "fail_closed_before_handler_or_stage_launch"
  },
  "domain_pack_action_abi": {
    "catalog_ref": "contracts/action_catalog.json",
    "catalog_version": "family-action-catalog.v2",
    "handler_registry_ref": "contracts/domain_handler_registry.json",
    "handler_registry_version": "domain-handler-registry.v1",
    "catalog_and_registry_are_closed_objects": true,
    "execution_binding_union": [
      {
        "kind": "handler_ref",
        "required_shape": {
          "kind": "handler_ref",
          "handler_ref": "handler:<handler_id>"
        }
      },
      {
        "kind": "stage_binding",
        "required_shape": {
          "kind": "stage_binding",
          "stage_manifest_ref": "agent/stages/manifest.json"
        }
      },
      {
        "kind": "foundry_binding",
        "required_shape": {
          "kind": "foundry_binding",
          "provider_manifest_ref": "contracts/foundry_provider.json"
        }
      }
    ],
    "handler_binding_union": [
      "typescript_export",
      "python_callable"
    ],
    "input_schema_validation_before_launch": true,
    "handler_output_schema_validation_before_success": true,
    "stage_output_schema_is_expected_domain_output_contract_not_launch_receipt_schema": true,
    "handler_refs_must_resolve_before_launch": true,
    "stage_manifest_must_compile_before_launch": true
  },
  "domain_lifecycle_admission": {
    "capability_id": "opl_domain_lifecycle_admission.v1",
    "identity_only_initialization": {
      "trigger": "catalog_declared_initialization_and_inventory_item_without_lifecycle_ref",
      "authority": "installed_domain_internal_handler",
      "host_role": "bind_original_invocation_and_materialize_exact_domain_authorized_bytes",
      "same_action_run_continues_after_initialization": true,
      "existing_lifecycle_is_not_reinitialized": true,
      "concurrent_inventory_changes_are_not_overwritten": true
    },
    "progress_first": {
      "unknown_or_insufficient_quality_blocks_research_admission": false,
      "publication_or_submission_permission_required_for_research_admission": false,
      "research_admission_grants_publication_or_submission_permission": false,
      "research_admission_implies_quality_pass": false,
      "qualification_only_or_explicitly_disallowed_research_is_admitted": false,
      "inactive_lifecycle_requires_domain_reactivation_authority": true
    }
  },
  "handler_execution": {
    "host_owner": "runway",
    "supported_bindings": [
      "typescript_export",
      "python_callable"
    ],
    "current_runtime_kinds": [
      "node_permission_model",
      "python_audit_hook"
    ],
    "current_sandbox_kind": "macos_sandbox_exec",
    "sandbox_required": true,
    "network_allowed": false,
    "filesystem_write_allowed": false,
    "subprocess_allowed_for_python_handler": false,
    "native_carrier_root_and_workspace_read_only_access": true,
    "stdout_contract": "exactly_one_canonical_json_value",
    "timeout_fail_closed": true,
    "completed_status_means": "handler_process_and_schema_validation_completed",
    "completed_status_is_domain_ready": false
  },
  "qualification_provisioning": {
    "surface_owner": "one-person-lab",
    "surface_status": "available_only_when_installed_domain_contract_declares_exact_action",
    "exact_argv": "opl agents run --domain mas --action qualification_work_item_provisioning_authority_evaluate --workspace <workspace_root> --payload-file <request.json> --run-id <stable_run_id> --json",
    "framework_trusted_route": true,
    "domain_action_remains_internal_only": true,
    "shell_direct_internal_handler_invocation_allowed": false,
    "action_id": "qualification_work_item_provisioning_authority_evaluate",
    "execution_scope_kind": "none",
    "handler_ref_source": "bound_owner_action_registry",
    "owner_contract_binding": {
      "action_boundary_field": "qualification_provisioning_contract",
      "required_fields": ["ref", "sha256"],
      "profile_version": "opl-qualification-provisioning-host.v1",
      "profile_fields": ["version", "identity_output_field", "work_item_id_field", "work_item_root_field"],

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-person-lab.local/contracts/opl-framework/durable-knowledge-recall-receipt.schema.json",
  "title": "OPL durable knowledge recall receipt",
  "description": "Records which exact knowledge and skill bodies were available to a Stage Attempt; it is context evidence, not a quality or truth verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surface_kind",
    "version",
    "domain_id",
    "stage_id",
    "selected",
    "authority_boundary"
  ],
  "properties": {
    "surface_kind": {
      "const": "opl_durable_knowledge_recall_receipt"
    },
    "version": {
      "const": "durable-knowledge-recall-receipt.v1"
    },
    "domain_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_id": {
      "type": "string",
      "minLength": 1
    },
    "task_intent": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "knowledge_id",
          "layer",
          "body_ref",
          "sha256",
          "selection_reason"
        ],
        "properties": {
          "knowledge_id": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "enum": [
              "agent_pack",
              "workspace_shared",
              "workspace_project",
              "dated_state"
            ]
          },
          "body_ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "selection_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "quality_debt": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_evidence_only",
        "can_authorize_quality_verdict",
        "can_authorize_domain_truth",
        "can_replace_owner_receipt"
      ],
      "properties": {
        "context_evidence_only": {
          "const": true
        },
        "can_authorize_quality_verdict": {
          "const": false
        },
        "can_authorize_domain_truth": {
          "const": false
        },
        "can_replace_owner_receipt": {
          "const": false
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-person-lab.local/contracts/opl-framework/durable-knowledge-item.schema.json",
  "title": "OPL durable knowledge item",
  "description": "Body-free catalog entry for reusable agent knowledge or workspace memory. The owner of body_ref retains semantic authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surface_kind",
    "version",
    "knowledge_id",
    "title",
    "layer",
    "owner",
    "body_ref",
    "applicability",
    "status",
    "reviewed_at",
    "next_review_at",
    "authority_boundary"
  ],
  "properties": {
    "surface_kind": {
      "const": "opl_durable_knowledge_item"
    },
    "version": {
      "const": "durable-knowledge-item.v1"
    },
    "knowledge_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "layer": {
      "enum": [
        "agent_pack",
        "workspace_shared",
        "workspace_project",
        "dated_state"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "body_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "repo_path",
            "workspace_path",
            "external_ref"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domains",
        "stages"
      ],
      "properties": {
        "domains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "deprecated",
        "superseded",
        "expired",
        "quarantined"
      ]
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_review_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "ref"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "freshness_policy": {
      "type": "string",
      "minLength": 1
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_body_owner",
        "opl_role"
      ],
      "properties": {
        "semantic_body_owner": {
          "type": "string",
          "minLength": 1
        },
        "opl_role": {
          "const": "catalog_recall_and_receipt_projection_only"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-person-lab.local/contracts/opl-framework/durable-knowledge-item.schema.json",
  "title": "OPL durable knowledge item",
  "description": "Source-owned knowledge with independent scope, content kind and temporal validity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surface_kind",
    "version",
    "knowledge_id",
    "title",
    "owner",
    "body_ref",
    "applicability",
    "status",
    "reviewed_at",
    "next_review_at",
    "authority_boundary",
    "scope",
    "content_kind"
  ],
  "properties": {
    "surface_kind": {
      "const": "opl_durable_knowledge_item"
    },
    "version": {
      "const": "durable-knowledge-item.v2"
    },
    "knowledge_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "body_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "repo_path",
            "source_path"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domains",
        "stages"
      ],
      "properties": {
        "domains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "deprecated",
        "superseded",
        "expired",
        "quarantined"
      ]
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_review_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "ref"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "freshness_policy": {
      "type": "string",
      "minLength": 1
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_body_owner",
        "opl_role"
      ],
      "properties": {
        "semantic_body_owner": {
          "type": "string",
          "minLength": 1
        },
        "opl_role": {
          "const": "catalog_recall_and_receipt_projection_only"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "product",
            "owner",
            "topic",
            "project"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "content_kind": {
      "enum": [
        "mechanism",
        "policy",
        "state",
        "decision"
      ]
    },
    "requirement": {
      "enum": [
        "required",
        "optional"
      ]
    },
    "action_critical": {
      "type": "boolean"
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "knowledge_id",
          "sha256"
        ],
        "properties": {
          "knowledge_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "properties": {
              "kind": {
                "const": "product"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "body_ref": {
            "properties": {
              "kind": {
                "const": "repo_path"
              }
            },
            "not": {
              "required": [
                "source_id"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "body_ref": {
            "required": [
              "source_id",
              "sha256"
            ],
            "properties": {
              "kind": {
                "const": "source_path"
              }
            }
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onepersonlab.dev/contracts/opl-framework/software-catalog-index.schema.json",
  "title": "OPL Software Catalog Static Index",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "catalog_id",
    "catalog_name",
    "categories",
    "package_count",
    "packages"
  ],
  "properties": {
    "schema_version": { "const": "opl_software_catalog_index.v1" },
    "catalog_id": { "type": "string", "minLength": 1 },
    "catalog_name": { "type": "string", "minLength": 1 },
    "catalog_repo": { "type": "string", "minLength": 1 },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["agents", "applications", "extensions", "channels", "dependencies"]
      }
    },
    "package_count": { "type": "integer", "minimum": 0 },
    "counts_by_category": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "package_id",
          "category",
          "software_type",
          "version",
          "visibility",
          "manifest_path",
          "manifest_sha256",
          "manifest"
        ],
        "properties": {
          "package_id": { "type": "string", "minLength": 1 },
          "category": {
            "type": "string",
            "enum": ["agents", "applications", "extensions", "channels", "dependencies"]
          },
          "software_type": {
            "type": "string",
            "enum": ["agent", "application", "extension", "channel", "dependency"]
          },
          "version": { "type": "string" },
          "visibility": { "type": "string", "enum": ["public", "authorized_only"] },
          "public_summary": {
            "type": "object",
            "additionalProperties": false,
            "required": ["owner_source_repo", "display_name"],
            "properties": {
              "owner_source_repo": { "type": "string", "minLength": 1 },
              "display_name": { "type": "string", "minLength": 1 },
              "display_name_i18n": { "$ref": "#/$defs/publicSummaryLocales" },
              "description_i18n": { "$ref": "#/$defs/publicSummaryLocales" }
            }
          },
          "manifest_path": { "type": "string", "minLength": 1 },
          "manifest_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "payload_path": { "type": ["string", "null"] },
          "payload_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
          "allowlist_path": { "type": ["string", "null"] },
          "allowlist_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
          "manifest": { "type": "object" },
          "payload": { "type": ["object", "null"] },
          "allowlist": { "type": ["object", "null"] }
        }
      }
    }
  },
  "$defs": {
    "publicSummaryLocales": {
      "type": "object",
      "propertyNames": { "enum": ["zh", "en", "zh-CN", "en-US"] },
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}

{
  "surface_kind": "opl_durable_knowledge_lifecycle_contract",
  "version": "opl-durable-knowledge-lifecycle.v2",
  "owner": "one-person-lab",
  "state": "active_contract",
  "purpose": "Define the common lifecycle for reusable knowledge and dated memory across OPL agents and workspaces without transferring domain truth, body ownership, or quality verdicts to OPL.",
  "scope": {
    "applies_to": [
      "standard_domain_agent",
      "domain_workspace",
      "stage_attempt_context"
    ],
    "covers": [
      "product_knowledge",
      "owner_and_topic_knowledge",
      "project_knowledge",
      "dated_state",
      "decision_records",
      "derived_context",
      "source_bindings_and_execution_snapshots"
    ],
    "does_not_cover": [
      "provider_workflow_history",
      "raw_chat_transcript_as_truth",
      "domain_artifact_body_ownership",
      "quality_or_export_verdict"
    ]
  },
  "knowledge_item_requirements": {
    "required_fields": [
      "knowledge_id",
      "title",
      "scope",
      "content_kind",
      "owner",
      "body_ref",
      "applicability",
      "status",
      "reviewed_at",
      "next_review_at"
    ],
    "recommended_fields": [
      "sources",
      "supersedes",
      "superseded_by",
      "freshness_policy",
      "requirement",
      "action_critical",
      "derived_from"
    ],
    "identity_policy": "stable_across_body_revisions",
    "body_addressing_policy": "exact_sha256_at_stage_binding",
    "unknown_metadata_policy": "reject_unknown_fields",
    "time_policy": "review_and_expiry_dates_required_for_all_items"
  },
  "recall_policy": {
    "selection_unit": "small_stage_relevant_knowledge_set",
    "selection_inputs": [
      "domain_id",
      "stage_id",
      "task_intent",
      "project_scope",
      "applicability",
      "status",
      "review_currentness"
    ],
    "default_missing_knowledge_behavior": "missing_agent_catalog_is_invalid; optional_workspace_catalogs_add_quality_debt",
    "must_record_consumed_refs": true,
    "must_record_body_sha256": true,
    "must_record_selection_reason": true,
    "may_rank_candidates": true,
    "may_make_quality_verdict": false,
    "may_override_stage_goal": false,
    "must_not_inject_all_knowledge": true,
    "task_matching": "exact_task_intent_when_declared; StageRun uses action_id",
    "execution_binding": "one_private_exact_snapshot_per_stage_run_shared_by_all_quality_roles",
    "public_projection": "receipt_and_snapshot_ref_only_no_private_body",
    "static_knowledge_refs": "authoring_references_only_never_bypass_catalog_lifecycle",
    "direct_skill_binding": "knowledge_prepare_then_explicit_private_read_context_uses_stage_snapshot_store",
    "direct_source_read": "resolve_authorized_source_then_freeze_exact_bytes",
    "required_knowledge": "required_item_ids_and_blueprint_requirements_fail_closed; optional_items_report_quality_debt",
    "derived_knowledge": "transitive_source_versions_currentness_and_authorization",
    "snapshot_reuse": "historical_bytes_immutable; live_authorization_rechecked_before_every_body_read",
    "action_revalidation": "action_critical_items_and_dependencies_rechecked_before_executor_hydration_and_domain_action",
    "source_drift": "reject_drifted_items_until_owner_review; independent_optional_work_can_continue"
  },
  "writeback_policy": {
    "agent_may_propose": true,
    "opl_may_transport_proposal": true,
    "domain_or_project_owner_accepts_or_rejects": true,
    "opl_may_apply_without_owner_receipt": false,
    "proposal_must_include": [
      "source_refs",
      "target_scope",
      "content_kind",
      "proposed_rule_or_mechanism",
      "evidence_class",
      "review_requirement"
    ],
    "automatic_promotion_from_state": false,
    "automatic_promotion_from_single_task": false,
    "accepted_writeback_requires_receipt": true,
    "body_writer": "domain_or_user_owner_via_common_mechanical_writer",
    "accepted_writeback_identity": "proposal_digest_original_body_digest_replacement_body_digest_registry_digest_and_actual_review_ref",
    "concurrent_source_change": "reject_overwrite_and_reconcile_before_retry; local_lock_is_not_cross_device_transaction",
    "owner_edit_review": "review_source_records_current_bytes_and_acceptance_without_rewriting_original",
    "owner_retirement": "explicit_review_of_exact_body_and_registry; retain_private_workspace_recovery_then_mark_deprecated_before_conditional_source_removal",
    "retirement_identity": "preserve_knowledge_id_original_locator_and_accepted_digest; recovery_evidence_is_not_current_knowledge",
    "retirement_recovery": "same_scoped_request_resumes_retained_intent; historical_replay_cannot_delete_recreated_body_or_reactivate_item"
  },
  "lifecycle_states": [
    "draft",
    "active",
    "deprecated",
    "superseded",
    "expired",
    "quarantined"
  ],
  "authority_boundary": {
    "opl_owns_common_lifecycle_contract": true,
    "opl_owns_catalog_and_body_free_index": true,
    "opl_owns_stage_recall_and_consumption_receipts": true,
    "opl_owns_workspace_topology_and_locator_validation": true,
    "domain_owns_knowledge_body_and_semantic_acceptance": true,
    "project_owner_owns_project_memory_body": true,
    "opl_can_write_domain_truth": false,
    "opl_can_write_domain_memory_body": false,
    "opl_can_accept_or_reject_semantic_knowledge": false,
    "opl_can_authorize_quality_or_export": false,
    "provider_completion_counts_as_knowledge_acceptance": false,
    "opl_can_apply_owner_accepted_bytes_mechanically": true
  },
  "non_authority_flags": {
    "knowledge_is_route_verdict": false,
    "knowledge_is_quality_verdict": false,
    "knowledge_is_domain_truth": false,
    "recall_receipt_proves_answer_correctness": false
  },
  "scope_model": {
    "product": {
      "role": "versioned_reusable_domain_knowledge",
      "owner": "domain_product_owner",
      "body_source": "distributable_package_repo_path"
    },
    "owner": {
      "role": "cross_topic_person_or_team_knowledge",
      "owner": "user_or_team",
      "body_source": "explicitly_bound_local_markdown_source"
    },
    "topic": {
      "role": "long_lived_domain_knowledge_shared_by_authorized_projects",
      "owner": "user_or_team_topic_owner",
      "body_source": "explicitly_bound_local_markdown_source"
    },
    "project": {
      "role": "specific_project_design_and_accepted_decisions",
      "owner": "project_owner",
      "identity": "workspace_inventory_project_id",
      "body_source": "explicitly_bound_local_markdown_source"
    }
  },
  "content_kinds": [
    "mechanism",
    "policy",
    "state",
    "decision"
  ],
  "source_model": {
    "registry_schema_ref": "contracts/opl-framework/knowledge-source-registry.schema.json",
    "binding_schema_ref": "contracts/opl-framework/knowledge-source-bindings.schema.json",
    "binding_ref": "shared/memory/knowledge-bindings.json",
    "registry_owner": "existing_profile_or_workspace_private_control_plane",
    "canonical_body": "one_editable_source_per_knowledge_id",
    "sources": "local_markdown_inside_or_outside_workspace",
    "intermediate_full_text_projection_required": false,
    "scope_binding": "explicit_source_ids_and_scope_ids_intersect_live_registry_grants",
    "project_identity": "resolve_project_root_through_workspace_index_projects",
    "semantic_owner_requirement_binding": "explicit_requirement_id_owner_id_knowledge_ids_mapping_or_exact_owner_identity",
    "source_root_from_agent_package": false
  }
}

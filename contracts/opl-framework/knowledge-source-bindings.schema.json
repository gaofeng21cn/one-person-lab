{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://one-person-lab.local/contracts/opl-framework/knowledge-source-bindings.schema.json",
  "title": "Explicit workspace knowledge source bindings",
  "required": [
    "surface_kind",
    "version",
    "registries"
  ],
  "properties": {
    "surface_kind": {
      "const": "opl_knowledge_source_bindings"
    },
    "version": {
      "const": "knowledge-source-bindings.v2"
    },
    "registries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "registry_ref",
          "source_ids",
          "scope_ids"
        ],
        "properties": {
          "registry_ref": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "scope_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "required_knowledge_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "requirement_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "semantic_owner_ref",
          "owner_id",
          "knowledge_ids"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "semantic_owner_ref": {
            "type": "string",
            "minLength": 1
          },
          "owner_id": {
            "type": "string",
            "minLength": 1
          },
          "knowledge_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}

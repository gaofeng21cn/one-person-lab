    },
    {
      "entrypoint_id": "med-autopractice.demo",
      "kind": "cli",
      "argv": [
        "python3",
        "scripts/map_demo.py"
      ],
      "scope": "synthetic_only"
    },
    {
      "entrypoint_id": "med-autopractice.inspect-site",
      "kind": "cli",
      "argv": [
        "python3",
        "scripts/site_plan.py",
        "--inspect"
      ],
      "read_only": true
    }
  ],

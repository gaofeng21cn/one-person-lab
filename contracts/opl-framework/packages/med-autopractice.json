  "presentation": {
    "display_name_i18n": {
      "zh-CN": "Med Auto Practice",
      "en-US": "Med Auto Practice"
    },
    "description_i18n": {
      "zh-CN": "医生主导的临床工作智能体，支持病历结构化、医嘱协作和医院系统适配。",
      "en-US": "A clinician-directed agent for structured records, order review and hospital system integration."
    },
    "session_routing_summary_i18n": {
      "zh-CN": "告诉 MAP 想完成哪项临床工作。它可以整理已有病历、恢复待审任务，或检查本院配置并协助验证所需的系统操作。",
      "en-US": "Tell MAP what you want to do. It can structure records you have, resume a task under review, or check your site configuration and help verify the operation you need."
    },
    "home_shortcuts": [],
    "software_type": "agent",
    "icon_ref": "assets/branding/medautopractice-logo.png"
  },
  "capability_abi": {
    "id": "med-autopractice.capabilities",
    "version": "1.0.0",
    "compatibility_policy": "same_major"
  },

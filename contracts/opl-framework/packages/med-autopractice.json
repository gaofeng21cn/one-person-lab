{
  "surface_kind": "opl_capability_package_manifest.v2",
  "package_id": "med-autopractice",
  "display_name": "Med Auto Practice",
  "description": "医生主导的临床工作智能体，支持病历结构化、医嘱协作和医院系统适配。",
  "publisher": "gaofeng21cn",
  "version": "0.1.6",
  "source": "first_party_owner_projection",
  "source_repo": "https://github.com/gaofeng21cn/med-autopractice.git",
  "visibility": "public",
  "package_role": "capability_package",
  "publication_channel_admission": "admitted",
  "presentation": {
    "display_name_i18n": {
      "zh-CN": "Med Auto Practice",
      "en-US": "Med Auto Practice"
    },
    "description_i18n": {
      "zh-CN": "医生主导的临床工作智能体，支持病历结构化、医嘱协作和医院系统适配。",
      "en-US": "A clinician-directed agent for structured records, order review and hospital system integration."
    },
    "session_routing_summary_i18n": {
      "zh-CN": "告诉 MAP 想完成哪项临床工作。它可以整理已有病历、恢复待审任务，或检查本院配置并协助验证所需的系统操作。",
      "en-US": "Tell MAP what you want to do. It can structure records you have, resume a task under review, or check your site configuration and help verify the operation you need."
    },
    "home_shortcuts": [],
    "software_type": "agent",
    "icon_ref": "assets/branding/medautopractice-logo.png"
  },
  "capability_abi": {
    "id": "med-autopractice.capabilities",
    "version": "1.0.0",
    "compatibility_policy": "same_major"
  },
  "exports": {
    "core_skill_ids": [
      "med-autopractice",
      "map-site-adaptation"
    ],
    "core_module_ids": [
      "med-autopractice.runtime"
    ],
    "optional_skill_policy_ref": "skills/med-autopractice/SKILL.md",
    "optional_skills_installed_by_default": false,
    "default_materialization_policy": "core_skills_only"
  },
  "entrypoints": [
    {
      "entrypoint_id": "med-autopractice.inspect",
      "kind": "cli",
      "argv": [
        "python3",
        "scripts/project_status.py",
        "--json"
      ],
      "read_only": true
    },
    {
      "entrypoint_id": "med-autopractice.synthetic-runtime",
      "kind": "cli",
      "argv": [
        "python3",
        "scripts/map_runtime.py"
      ],
      "scope": "synthetic_only"
    },
    {
      "entrypoint_id": "med-autopractice.local-runtime",
      "kind": "cli",
      "argv": [
        "python3",
        "scripts/map_runtime.py"
      ],
      "scope": "explicit_site"
    },
    {
      "entrypoint_id": "med-autopractice.demo",
      "kind": "cli",
      "argv": [
        "python3",
        "scripts/map_demo.py"
      ],
      "scope": "synthetic_only"
    },
    {
      "entrypoint_id": "med-autopractice.inspect-site",
      "kind": "cli",
      "argv": [
        "python3",
        "scripts/site_plan.py",
        "--inspect"
      ],
      "read_only": true
    },
    {
      "entrypoint_id": "med-autopractice.mcp",
      "kind": "cli",
      "argv": [
        "python3",
        "scripts/map_mcp.py",
        "--mode",
        "synthetic",
        "--transport",
        "stdio"
      ],
      "scope": "synthetic_only"
    },
    {
      "entrypoint_id": "med-autopractice.site-sync",
      "kind": "cli",
      "argv": [
        "python3",
        "scripts/site_sync.py",
        "--help"
      ],
      "read_only": true
    }
  ],
  "codex_surface": {

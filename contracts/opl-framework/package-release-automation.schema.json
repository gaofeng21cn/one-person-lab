{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-person-lab.local/contracts/opl-framework/package-release-automation.schema.json",
  "title": "Owner Package daily release settings",
  "type": "object",
  "required": ["strategy", "prepare", "verify"],
  "properties": {
    "strategy": { "enum": ["daily_patch", "manual"] },
    "prepare": { "$ref": "#/$defs/commands" },
    "verify": { "$ref": "#/$defs/commands" },
    "release_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" }
    },
    "release_workflows": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\\.ya?ml$" }
    },
    "version_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
          "kind": { "enum": ["json", "toml_project", "python_version", "plist_bundle", "xml_project"] }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "commands": {
      "type": "array",
      "items": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
    }
  },
  "additionalProperties": false
}

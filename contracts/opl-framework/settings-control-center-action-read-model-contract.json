    "settings_projection": {
      "surface_kind": "opl_settings_projection.v1",
      "purpose": "Settings-specific projection sections for App/Studio rendering so the UI does not infer Settings IA from broad app_state.",
      "ordinary_sections": [
        "overview",
        "gateway",
        "models",
        "workspace",
        "agents",
        "capabilities",
        "resources",
        "maintenance",
        "storage",
        "preferences"
      ],
      "compatibility_sections": {
        "diagnostics": {
          "parent_section": "maintenance",
          "ordinary_visible": false,
          "policy": "maintenance_drilldown_and_legacy_route_compatibility_only"
        }
      },
      "item_required_fields": [
        "surface_class",
        "scope",
        "owner",
        "risk",
        "normal_summary",
        "next_action",
        "details_ref",
        "editable_reason"
      ],
      "section_surface_class_policy": "Every ordinary section and item declares status; diagnostics is a Maintenance drilldown/compatibility section, while configuration and one-time actions use their dedicated catalogs.",
      "shell_consumer_policy": "The shell consumes this Settings-specific projection by App-owned page id and must not infer Settings layout from broad app_state or compatibility settings_ia groups.",
      "layout_authority": {
        "owner": "one-person-lab-app",
        "source_ref": "one-person-lab-app/contracts/app-product-profile.json#settings_control_center",
        "framework_role": "status_action_and_compatibility_projection_only"
      },
      "authority_policy": "settings_projection_is_read_model_only_no_live_readiness_or_release_claim"
    },
    "capability_task_awareness_refs": {
      "surface_kind": "opl_settings_capability_task_awareness_refs.v1",
      "purpose": "Refs-only Settings/Capabilities slice for capability health, connector readiness, reusable workflow refs, and export bundle preview entrypoints without moving domain truth into Settings.",
      "required_fields": [
        "capability_health_refs",
        "connector_readiness_refs",
        "workflow_refs",
        "content_policy",
        "authority_boundary"
      ],
      "content_policy": "refs_only_no_skill_body_no_workflow_body"
    },
    "docker_webui": {
      "surface_kind": "opl_settings_docker_webui_read_model.v1",
      "purpose": "Framework initialization and diagnostic routes inside a separately deployed WebUI. The compatibility field one_click_install initializes Framework only; Studio owns actual WebUI deployment. Ordinary status is not_checked regardless of model credentials, without probing Docker on ordinary Settings reads.",
      "required_fields": [
        "one_click_install",
        "api_key_configuration",
        "seed_image_selection",
        "startup_maintenance",
        "runtime_proxy",
        "failure_recovery",
        "ordinary_next_actions",
        "authority_boundary"
      ],
      "doctor_surface": "opl system docker-webui doctor --json",
      "doctor_read_model_ref": "docker_webui_doctor",
      "policy": {
        "app_and_opl_are_policy_action_source": true,
        "studio_shell_is_adapter_view_model_consumer_only": true,
        "shell_must_not_copy_webui_policy": true,
        "ordinary_settings_read_must_not_probe_docker": true,
        "secret_payload_policy": "stdin_only_never_json_or_logs",
        "runtime_readiness_claim": "not_claimed"
      }
    },
    "storage_lifecycle": {
      "surface_kind": "opl_settings_storage_owner_read_model.v1",
      "purpose": "Fail-open owner-scoped usage inventory for Agent Package storage and WebUI data without creating a second cleanup engine.",
      "required_fields": [
        "snapshot_updated_at",
        "agent_package_store",
        "webui_data_volume",
        "action_surface",
        "owner_action_ids",
        "authority_boundary"
      ],
      "inventory_action_ids": [
        "settings_inventory_agent_package_store",
        "settings_inventory_webui_data_volume"
      ],
      "status_values": [
        "available",
        "attention_required",
        "unavailable",
        "not_configured"
      ],
      "policy": {
        "ordinary_read_uses_bounded_snapshot_only": true,
        "inventory_is_explicit_and_lazy": true,
        "unknown_bytes_remain_null": true,
        "agent_package_storage_capacity_authority": "native_carrier_owned_unmeasured",
        "legacy_package_lock_or_lkg_inventory_allowed": false,
        "raw_lock_or_filesystem_owner_inference_forbidden": true,
        "package_root_selection": "none_no_framework_byte_ownership_inference",
        "agent_package_cleanup_action": "agent_package_uninstall",
        "agent_package_storage_action_policy": "navigate_to_agents_reuse_owner_uninstall_no_duplicate_storage_lifecycle",
        "webui_projects_excluded": true,
        "webui_destructive_action_owner": "carrier_host",
        "missing_carrier_host_capability": "status_only_fail_open",
        "generic_docker_prune_allowed": false,
        "shell_direct_filesystem_or_package_mutation_allowed": false
      },
      "owner_preview_boundary": {
        "agent_package_store": "Framework projects unknown bytes and the existing Agents owner route; the native carrier owns capacity and cleanup, and Framework does not project a delete plan.",
        "webui_data_volume": "Framework projects measured bytes plus host_action_required ABI only; plan, execute, restore, archive, manifest, and receipt refs remain carrier-host owned."
      }
    },
    "shell_policy": {
      "app_consumes_read_model_only": true,
      "studio_shell_is_renderer_only": true,
      "shell_must_not_rewrite_model_or_reasoning_policy": true,
      "shell_must_not_infer_api_key_or_workspace_service_truth": true,
      "shell_must_not_execute_unlisted_actions": true
    }
  },

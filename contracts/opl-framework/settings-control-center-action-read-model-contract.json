    "post_mutation_native_readback_required": true,
    "fixed_tap_membership_required": true,
    "uninstall_no_zap": true,
    "refresh_changes_recipes_not_installed_software": true,
    "refresh_recipe_scope": "all_homebrew_managed_recipe_metadata",
    "missing_homebrew_behavior": "show_official_installation_entry_without_running_remote_installer",
    "catalog_provenance": {
      "catalog_origin": "opl",
      "origin_basis": "owner_projection",
      "catalog_source": {
        "manager": "homebrew",
        "marketplace_id": "gaofeng21cn/one-person-lab",
        "delivery": "marketplace"
      },
      "classification_basis": "verified_fixed_tap_membership",
      "changes_lifecycle_authority": false
    },
    "second_registry": false,
    "second_updater": false
  },
  "installed_software_products": {
    "source": "software_sources.installed_products",
    "independent_of_distribution_source_availability": true,
    "framework_update_owner": "opl_framework_self_update",
    "framework_release_authority": "independent_framework_oci_channel",
    "framework_release_refresh_action": "source_check:public-registry:opl",
    "framework_release_refresh_hint": "catalog_refresh_required",
    "framework_update_action": "software_installation_execute",
    "framework_update_payload": ["package_id", "installation_id", "expected_revision", "operation", "version"],
    "framework_update_statuses": ["available", "current", "needs_restart", "unknown"],
    "framework_update_rechecks_installation_and_channel": true,
    "framework_update_preserves_active_generation_until_restart": true,
    "framework_update_mutates_codex": false,
    "framework_update_overwrites_development_checkout": false
  },
  "configuration_catalog": {
    "surface_kind": "opl_settings_configuration_catalog.v1",
    "owner": "one-person-lab",

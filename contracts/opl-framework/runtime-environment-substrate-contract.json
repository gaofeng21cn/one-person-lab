{
  "contract_id": "opl_runtime_environment_substrate_contract",
  "schema_version": "opl-runtime-environment-substrate.v1",
  "owner": "OPL Framework",
  "state": "active_contract",
  "implementation_status": "cached_language_environments_and_lightweight_execution",
  "target_planned": false,
  "purpose": "Run dependency-bearing temporary tasks efficiently using standard language tools and reusable caches; record resolved environments once and reference them per execution.",
  "ordinary_path": {
    "ordinary_user_commands": [
      "opl env doctor",
      "opl env prepare",
      "opl env run"
    ],
    "advanced_operator_surface": "opl runtime env inspect|prepare|cache|doctor|run-context|contract",
    "default_provider_kind": "fast_local_env",
    "automatic_prepare_on_run": true,
    "domain_agents_declare_dependency_intent_only": true
  },
  "execution_policy": {
    "backend": "host_process",
    "python_tool": "uv",
    "r_tool": "renv",
    "cache_identity": [
      "dependency_requirements_and_sources",
      "runtime_binary_identity",
      "referenced_lock_content"
    ],
    "cache_shared_across_domains_and_artifact_roots": true,
    "dependency_declaration_order_affects_cache": false,
    "prepare_only_on_miss_or_requirement_change": true,
    "run_does_not_load_package_catalog_on_cache_hit": true,
    "package_cache_reused_when_dependency_set_changes": true,
    "timeout_and_cancellation": "terminate_process_group",
    "unsupported_environment_selection": "reject_no_silent_host_fallback"
  },
  "dependency_prepare_policy": {
    "status": "uv_and_renv_preparation_with_shared_cache",
    "writes_dependency_lock": true,
    "writes_dependency_receipt": true,
    "writes_run_context_on_success": true,
    "run_context_consumer_preflight": "fail_closed_on_missing_run_context_or_target_mismatch",
    "run_context_identity_required": true,
    "installs_packages": "only_when_apply_into_opl_managed_r_library_or_python_uv_environment",
    "package_presence_verification": "once_on_environment_preparation",
    "r_standard_handoff": {
      "tool": "renv",
      "managed_library_environment": "R_LIBS_USER",
      "global_package_cache": true
    },
    "python_standard_handoff": {
      "tool": "uv",
      "lock_refs": [
        "uv.lock",
        "pyproject.toml"
      ],
      "managed_environment": "UV_PROJECT_ENVIRONMENT"
    },
    "r_package_environment": "R_LIBS_USER",
    "supported_r_package_sources": [
      "cran",
      "github",
      "bioconductor"
    ],
    "bioconductor_installer": "renv",
    "python_package_environment": "UV_PROJECT_ENVIRONMENT",
    "python_installer": "uv",
    "requirement_profile_selection": "all_profiles_by_default_or_scoped_by_requirement_profile_id",
    "ordinary_profile_source": {
      "descriptor_ref_field": "standard_contract_refs.runtime_environment_requirement_profile",
      "profile_map_field": "runtime_profile_sources",
      "provider_fields": [
        "package_id",
        "relative_path"
      ],
      "provider_resolution": "selected_package_module_source",
      "resource_boundary": "provider_repo_contained_json",
      "explicit_requirement_profile_takes_precedence": true
    },
    "host_environment_fallback_allowed": false,
    "writes_domain_truth": false,
    "writes_runtime_root": false,
    "missing_dependency_returns_runtime_failure": true,
    "can_claim_provider_ready": false,
    "can_claim_runtime_ready": false,
    "can_claim_domain_ready": false,
    "can_claim_publication_ready": false,
    "dependency_lock_semantics": "requirement_identity_not_complete_scientific_reproduction_lock"
  },
  "run_context_consumer_policy": {
    "status": "fail_closed_consumer_preflight_available",
    "requires_artifact_root_for_bound_readback": true,
    "compatibility_root_aliases": [
      {
        "option": "--paper-root",
        "field": "paper_root",
        "status": "compatibility_alias",
        "canonical_option": "--artifact-root",
        "canonical_field": "artifact_root"
      }
    ],
    "missing_run_context_status": "missing_run_context",
    "target_mismatch_status": "target_mismatch",
    "identity_fields": [
      "domain_id",
      "profile_id",
      "platform_id",
      "requirement_profile_identity",
      "lock_sha256",
      "run_context_fingerprint"
    ],
    "host_environment_fallback_allowed": false,
    "run_context_exists_counts_as_provider_ready": false,
    "run_context_exists_counts_as_domain_ready": false,
    "can_schedule_domain_stage": false,
    "can_claim_provider_ready": false,
    "can_claim_runtime_ready": false,
    "can_claim_domain_ready": false,
    "can_claim_app_release_ready": false
  },
  "recording_policy": {
    "environment_manifest": "environment.json identifies the current manifest; run contexts reference preserved manifests/<digest>.json snapshots",
    "manifest_fields": [
      "environment_id",
      "runtime_file_identities",
      "inventory",
      "prepared_at"
    ],
    "inventory_frequency": "environment_creation_or_explicit_refresh",
    "execution_records": "artifact-root/build/executions/<uuid>.json",
    "execution_fields": [
      "environment_id",
      "environment_ref",
      "command",
      "executable",
      "cwd",
      "started_at",
      "finished_at",
      "elapsed_ms",
      "exit_code",
      "stage_attempt_ref"
    ],
    "execution_record_failure_changes_command_outcome": false,
    "credentials_in_environment_variables_recorded": false,
    "full_input_output_hashing_required_for_temporary_tasks": false,
    "scientific_freeze_owner": "domain_agent"
  },
  "cache_policy": {
    "package_cache_owners": [
      "uv",
      "renv"
    ],
    "prepared_environment_reuse": true,
    "cache_hit_counts_as_ready": false,
    "cache_miss_counts_as_readiness_failure": false,
    "cleanup": "Use standard package-manager cache commands; never delete active environment or research output directories as package-cache entries."
  },
  "authority_boundary": {
    "opl_is_canonical_runtime_environment_owner": true,
    "app_consumes_runtime_environment_projection": true,
    "domain_agents_declare_dependency_intent_only": true,
    "can_write_domain_truth": false,
    "can_write_domain_memory_body": false,
    "can_write_artifact_body": false,
    "can_sign_owner_receipt": false,
    "can_create_typed_blocker": false,
    "can_claim_domain_ready": false,
    "can_claim_app_release_ready": false,
    "can_claim_runtime_materialized_ready": false,
    "can_claim_quality_or_export_verdict": false,
    "can_schedule_domain_stage": false
  },
  "readback_commands": [
    "opl env doctor",
    "opl env run --domain <domain> --profile <profile> [--requirement-profile <path>] [--artifact-root <path>] [--cwd <path>] [--timeout-ms <ms>] [--refresh] -- <command...>",
    "opl env prepare --domain <domain> --profile <profile> [--requirement-profile <path>] [--artifact-root <path>] [--refresh] --apply",
    "opl runtime env cache inventory",
    "opl runtime env run-context --domain <domain> --profile <profile> --artifact-root <path>"
  ],
  "forbidden_claims": [
    "environment_prepared_means_domain_ready",
    "cache_hit_means_scientific_result_reproducible",
    "execution_success_means_publication_ready"
  ]
}

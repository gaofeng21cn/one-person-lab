{
  "name": "opl-framework",
  "version": "0.3.5",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    "./cordis-profiles": "./dist/host/composition-profiles.js",
    "./foundry-protocol": "./dist/authority/evolution/protocol.js",
    "./foundry-protocol-fixture-conformance": "./dist/authority/evolution/protocol-fixture-conformance.js",
    "./foundry-control": "./dist/authority/evolution/control.js",
    "./advisory-knowledge-boundary": "./dist/authority/contracts/advisory-knowledge-boundary.js",
    "./family-action-catalog": "./dist/read-models/operator/family-action-catalog.js",
    "./family-domain-agent-descriptor": "./dist/read-models/catalog/family-domain-agent-descriptor.js",
    "./domain-pack-compiler": "./dist/authority/packages/domain-pack-compiler.js",
    "./domain-artifact-runtime": "./dist/authority/stages/domain-artifact-runtime.js",
    "./domain-helper-runtime": "./dist/adapters/execution/domain-helper-runtime.js",
    "./domain-source-runtime": "./dist/authority/workspace/domain-source-runtime.js",
    "./domain-task-runtime": "./dist/adapters/execution/domain-task-runtime.js",
    "./family-runtime-lifecycle-index": "./dist/adapters/execution/family-runtime-lifecycle-index.js",
    "./generic-substrate-projection": "./dist/adapters/execution/generic-substrate-projection.js",
    "./json-schema-registry": "./dist/kernel/schema-registry.js",
    "./family-domain-catalog": "./dist/read-models/catalog/family-domain-catalog.js",
    "./family-entry-contracts": "./dist/read-models/catalog/family-entry-contracts.js",
    "./foundry-agent-series-policy": "./dist/authority/packages/public/foundry-agent-series-policy.js",
    "./family-orchestration": "./dist/adapters/execution/family-orchestration.js",
    "./managed-runtime-contract": "./dist/adapters/execution/managed-runtime-contract.js",
    "./product-entry-companions": "./dist/read-models/operator/product-entry-companions.js",
    "./reference-build-proof": "./dist/authority/packages/reference-build-proof.js",
    "./source-derived-agent-design-abi": "./dist/authority/packages/public/source-derived-agent-design-abi.js",
    "./reference-design-pattern-packet": "./dist/authority/workspace/reference-design-pattern-packet.js",
    "./standard-agent-pack-abi": "./dist/authority/packages/public/standard-agent-pack-abi.js",
    "./standard-agent-implementation-profile": "./dist/authority/packages/public/standard-agent-implementation-profile.js",
    "./package-host-integration": "./dist/authority/packages/package-host-integration.js",
    "./cordis-package-host": "./dist/authority/packages/cordis-package-host-plugin.js"
  },
  "bin": {
    "opl": "./bin/opl"
  },
  "files": [
    "bin/opl",
    "dist",
    "contracts/opl-framework",
    "packages/cordis-abi/package.json",
    "packages/cordis-abi/dist",
    "packages/cordis-abi/contracts",
    "packages/package-host/package.json",
    "packages/package-host/dist",
    "packages/package-host/contracts",
    "python/opl_framework",
    "scripts/native-helper.mjs",
    "scripts/native-helper-doctor.mjs",
    "scripts/native-helper-family-smoke.mjs",
    "scripts/compile-opl-flow-capability-projections.mjs"
  ],
  "scripts": {
    "build": "npm run build:packages && tsc -p tsconfig.build.json",
    "prebuild": "node ./scripts/materialize-package-contracts.mjs",
    "build:packages": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "pretypecheck": "node ./scripts/materialize-package-contracts.mjs",
    "prepare": "npm run build",
    "native:doctor": "node ./scripts/native-helper-doctor.mjs",
    "native:repair": "node ./scripts/native-helper-doctor.mjs",
    "native:family-smoke": "node ./scripts/native-helper-family-smoke.mjs",
    "family:structure-advisory": "node ./scripts/family-structure-advisory.mjs",
    "refactor:patrol:contract": "node ./scripts/refactor-patrol-state.mjs contract",
    "refactor:patrol:validate": "node ./scripts/refactor-patrol-state.mjs validate",
    "packages:payload": "node ./scripts/first-party-package-payload.mjs",
    "packages:cleanup-ghcr": "node --experimental-strip-types ./scripts/cleanup-ghcr-package-versions.mjs",
    "codex:export-default-profile": "node --experimental-strip-types ./scripts/export-codex-default-profile.mjs --workflow-policy ../opl-flow/contracts/workflow-policy.json",
    "flow:capability:compile": "node --experimental-strip-types ./scripts/compile-opl-flow-capability-projections.mjs",
    "runtime:token-telemetry:canary": "node --experimental-strip-types ./scripts/family-runtime-token-telemetry-canary.ts",
    "capability-map:audit": "node ./scripts/capability-map-audit.mjs",
    "docs:whitepaper": "node --experimental-strip-types ./scripts/run-domain-whitepaper.ts --repo-root . --profile contracts/whitepaper_profile.json",
    "docs:whitepaper:framework": "node --experimental-strip-types ./scripts/run-domain-whitepaper.ts --repo-root . --profile contracts/framework-whitepaper_profile.json",
    "docs:whitepapers:family": "node --experimental-strip-types ./scripts/build-opl-family-whitepapers.ts",
    "docs:whitepapers:family:stage": "node --experimental-strip-types ./scripts/stage-family-whitepaper-artifact.ts --manifest tmp/pdfs/opl-family-whitepaper-build.json --output tmp/pdfs/opl-family-whitepaper-artifact",
    "docs:whitepapers:family:release": "node --experimental-strip-types ./scripts/build-opl-family-whitepapers.ts --mode release",
    "docs:latest": "npm run docs:whitepaper",
    "docs:publish": "bash scripts/publish-docs-latest.sh",
    "repo:hygiene": "scripts/repo-hygiene.sh",
    "repo:hygiene:fix": "scripts/repo-hygiene.sh --fix",
    "lint": "node ./scripts/lint.mjs",
    "hygiene:fallow": "npx --yes fallow@latest --root . --no-cache --production",
    "test:smoke": "node ./scripts/test-lanes.mjs run smoke",
    "test:fast": "node ./scripts/test-lanes.mjs run fast",
    "test:meta": "node ./scripts/test-lanes.mjs run meta",
    "test:read-model-gates": "node ./scripts/test-lanes.mjs run read-model-gates",
    "test:regression": "node ./scripts/test-lanes.mjs run regression",
    "test:integration": "node ./scripts/test-lanes.mjs run integration",
    "test:artifact": "node ./scripts/test-lanes.mjs run artifact",
    "test:fresh-install": "node ./scripts/test-lanes.mjs run fresh-install",
    "test:stage-run-mag-integration": "node ./scripts/test-lanes.mjs run stage-run-mag-integration",
    "test:native": "./scripts/verify.sh native",
    "test:structure": "./scripts/verify.sh structure",
    "test:full": "npm run test:artifact && npm run test:fast && npm run test:fresh-install && npm run test:structure && npm run typecheck && npm run lint && npm run test:read-model-gates && npm run test:meta && npm run test:regression && npm run test:integration && npm run test:native",
    "test": "npm run test:smoke",
    "line-budget": "node ./scripts/line-budget.mjs",
    "line-budget:strict": "node ./scripts/line-budget.mjs",
    "fresh-install:smoke": "node ./scripts/fresh-install-smoke.mjs",
    "new-machine:codex-bootstrap:docker-smoke": "node ./scripts/new-machine-codex-bootstrap-docker-smoke.mjs",
    "source:modules": "node ./scripts/source-module-boundary.mjs",
    "source:modules:public-imports": "node ./scripts/source-module-public-imports.mjs",
    "source:packages": "node ./scripts/source-package-boundary.mjs",
    "framework:archive": "node scripts/framework-archive.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/mcp": "0.0.79",
    "@temporalio/activity": "1.20.3",
    "@temporalio/client": "1.20.3",
    "@temporalio/common": "1.20.3",
    "@temporalio/worker": "1.20.3",
    "@temporalio/workflow": "1.20.3",
    "@types/semver": "7.7.1",
    "ajv": "^8.20.0",
    "semver": "7.8.5",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@temporalio/testing": "1.20.3",
    "@types/node": "^24.5.2"
  },
  "overrides": {
    "protobufjs": "7.6.5"
  },
  "license": "Apache-2.0",
  "optionalDependencies": {
    "e2b": "^2.31.0"
  }
}

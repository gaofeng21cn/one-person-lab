{
  "name": "opl-framework",
  "version": "0.3.27",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "opl": "./bin/opl",
    "opld": "./packages/daemon/bin/opld"
  },
  "files": [
    "bin/opl",
    "packages/*/package.json",
    "packages/*/dist",
    "packages/daemon/bin",
    "packages/core/migrations",
    "packages/mcp-app-shared/assets",
    "extensions",
    "sdks/python-client",
    "contracts/opl-package.v2.schema.json",
    "contracts/opl-framework/dependency-release-sources.json",
    "scripts/dependency-release-resolution.ts",
    "scripts/resolve-dependency-releases.mjs"
  ],
  "scripts": {
    "build": "node ./scripts/build-framework.mjs",
    "typecheck": "tsc -b --noEmit tsconfig.packages.json",
    "v2:build": "tsc -b tsconfig.packages.json",
    "v2:typecheck": "tsc -b --noEmit tsconfig.packages.json",
    "v2:guard": "node ./scripts/check-v2-import-guard.mjs --strict-m4",
    "v2:test": "node --experimental-strip-types --test packages/core/tests/*.test.ts packages/ledger/tests/*.test.ts packages/workspace/tests/*.test.ts packages/mcp-app-shared/tests/*.test.ts packages/connect/tests/*.test.ts packages/pack/tests/*.test.ts packages/runway/tests/*.test.ts packages/daemon/tests/*.test.ts",
    "prepare": "npm run build",
    "docs:whitepaper": "node --experimental-strip-types ./scripts/run-domain-whitepaper.ts --repo-root . --profile contracts/whitepaper_profile.json",
    "docs:whitepaper:framework": "node --experimental-strip-types ./scripts/run-domain-whitepaper.ts --repo-root . --profile contracts/framework-whitepaper_profile.json",
    "docs:whitepaper:miniapp": "node --experimental-strip-types ./scripts/run-domain-whitepaper.ts --repo-root . --profile contracts/miniapp-whitepaper_profile.json",
    "docs:whitepaper:occ": "node --experimental-strip-types ./scripts/run-domain-whitepaper.ts --repo-root . --profile contracts/occ-whitepaper_profile.json",
    "docs:whitepapers:family": "node --experimental-strip-types ./scripts/build-opl-family-whitepapers.ts",
    "docs:whitepapers:family:stage": "node --experimental-strip-types ./scripts/stage-family-whitepaper-artifact.ts --manifest tmp/pdfs/opl-family-whitepaper-build.json --output tmp/pdfs/opl-family-whitepaper-artifact",
    "docs:whitepapers:family:release": "node --experimental-strip-types ./scripts/build-opl-family-whitepapers.ts --mode release",
    "docs:latest": "npm run docs:whitepaper",
    "docs:publish": "bash scripts/publish-docs-latest.sh",
    "repo:hygiene": "scripts/repo-hygiene.sh",
    "repo:hygiene:fix": "scripts/repo-hygiene.sh --fix",
    "lint": "git diff --check",
    "hygiene:fallow": "npx --yes fallow@latest --root . --no-cache --production",
    "test:smoke": "node ./scripts/test-lanes.mjs run smoke",
    "test:fast": "node ./scripts/test-lanes.mjs run fast",
    "test:artifact": "node ./scripts/test-lanes.mjs run artifact",
    "test:structure": "./scripts/verify.sh structure",
    "test:full": "node ./scripts/test-lanes.mjs run full",
    "test:e2e": "node ./tests/e2e/run.mjs",
    "test": "npm run test:smoke",
    "framework:archive": "node scripts/framework-archive.mjs"
  },
  "dependencies": {
    "@types/semver": "7.8.0",
    "semver": "7.8.6",
    "tar": "7.5.23",
    "typescript": "7.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ajv": "8.20.0"
  },
  "overrides": {
    "protobufjs": "8.8.1"
  },
  "license": "Apache-2.0"
}

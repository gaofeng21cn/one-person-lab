{
  "schema_version": "opl.release.v1",
  "subject_id": "opl-framework",
  "kind": "product",
  "repository": "gaofeng21cn/one-person-lab",
  "schedule": "daily_patch",
  "trigger": "tag",
  "tag_prefix": "framework-v",
  "source_check_workflows": [
    "ci.yml",
    "verify.yml",
    "codeql.yml"
  ],
  "delivery_paths": [
    "bin",
    "packages",
    "extensions",
    "sdks/python-client",
    "contracts/opl-package.v2.schema.json",
    "contracts/opl-framework/dependency-release-sources.json",
    "scripts/build-framework.mjs",
    "scripts/build-mcp-app-view.mjs",
    "scripts/mcp-app-browser-entry.mjs",
    "scripts/framework-archive.mjs",
    "scripts/script-json-boundary.mjs",
    "scripts/dependency-release-resolution.ts",
    "scripts/resolve-dependency-releases.mjs",
    "scripts/oci-publication-preflight.mjs",
    "tsconfig.base.json",
    "tsconfig.packages.json",
    "package.json",
    "package-lock.json",
    "install.sh",
    ".github/workflows/publish-framework.yml"
  ],
  "version_files": [
    {
      "path": "package.json",
      "kind": "json"
    },
    {
      "path": "package-lock.json",
      "kind": "json"
    }
  ],
  "prepare": [],
  "verify": [],
  "lanes": [
    {
      "lane": "stable",
      "workflow": "publish-framework.yml",
      "primary": true,
      "channel": {
        "kind": "oci",
        "registry": "ghcr.io",
        "repository": "gaofeng21cn/one-person-lab-framework",
        "tag": "latest-stable"
      }
    },
    {
      "lane": "package",
      "workflow": "daily-package-channel.yml",
      "primary": false,
      "daily_dispatch": true
    }
  ]
}
